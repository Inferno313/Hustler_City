local function CreateLabel(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Text = text
	label.TextSize = size
	label.TextColor3 = color
	label.Font = font or Enum.Font.GothamBold
	label.BackgroundTransparency = 1
	label.Parent = parent
	return label
end

local function CreateButton(parent, text, size, bgColor, textColor, callback)
	local button = Instance.new("TextButton")
	button.Text = text
	button.TextSize = size
	button.TextColor3 = textColor
	button.Font = Enum.Font.GothamBold
	button.BackgroundColor3 = bgColor
	button.BorderSizePixel = 0
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(100, 100, 100)
	stroke.Thickness = 1
	stroke.Parent = button

	if callback then
		button.MouseButton1Click:Connect(callback)
	end

	return button
end

local function CreatePanel(parent, name)
	local panel = Instance.new("Frame")
	panel.Name = name
	panel.BackgroundColor3 = Colors.Panel
	panel.BorderSizePixel = 0
	panel.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = panel

	local stroke = Instance.new("UIStroke")
	stroke.Color = Colors.Gold
	stroke.Thickness = 2
	stroke.Parent = panel

	return panel
end

local function CreateScrollFrame(parent, name)
	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Name = name
	scrollFrame.BackgroundColor3 = Colors.Card
	scrollFrame.BorderSizePixel = 0
	scrollFrame.ScrollBarThickness = 8
	scrollFrame.ScrollBarImageColor3 = Colors.Gold
	scrollFrame.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = scrollFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 60, 100)
	stroke.Thickness = 1
	stroke.Parent = scrollFrame

	return scrollFrame
end

local function GetRarityColor(rarity)
	return RarityColors[rarity] or Colors.Dim
end

local function FormatMoney(amount)
	if amount >= 1000000 then
		return string.format("$%.1fM", amount / 1000000)
	elseif amount >= 1000 then
		return string.format("$%.1fK", amount / 1000)
	else
		return "$" .. tostring(math.floor(amount))
	end
end

local function TweenElement(element, properties, duration)
	local tweenInfo = TweenInfo.new(
		duration or 0.3,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.InOut
	)
	local tween = TweenService:Create(element, tweenInfo, properties)
	tween:Play()
	return tween
end

-- ============================================================================
-- HOTBAR (Roblox-style numbered slots 1-9)
-- ============================================================================

local HOTBAR_SLOT_SIZE = 65
local HOTBAR_SLOT_PADDING = 5
local MAX_HOTBAR_SLOTS = 9

local HotbarFrame = Instance.new("Frame")
HotbarFrame.Name = "Hotbar"
HotbarFrame.BackgroundTransparency = 1
HotbarFrame.BorderSizePixel = 0
HotbarFrame.ZIndex = 5
HotbarFrame.Parent = ScreenGui

-- We'll dynamically size the hotbar based on inventory count
local hotbarSlots = {}  -- array of Frame references

local function getHotbarWidth(count)
	local slotCount = math.min(count, MAX_HOTBAR_SLOTS)
	if slotCount < 1 then slotCount = 1 end
	return (HOTBAR_SLOT_SIZE * slotCount) + (HOTBAR_SLOT_PADDING * (slotCount - 1))
end

local function updateHotbarPosition(hotbarInv)
	local count = math.max(1, math.min(#hotbarInv, MAX_HOTBAR_SLOTS))
	local totalWidth = getHotbarWidth(count)
	HotbarFrame.Size = UDim2.new(0, totalWidth, 0, HOTBAR_SLOT_SIZE + 20)
	HotbarFrame.Position = UDim2.new(0.5, -totalWidth / 2, 1, -(HOTBAR_SLOT_SIZE + 30))
end

-- ============================================================================
-- HOTBAR FILTERED INVENTORY (only brainrots NOT on pedestals)
-- ============================================================================

local function getHotbarInventory()
	local filtered = {}
	for _, brainrot in ipairs(State.inventory) do
		if not brainrot.pedestalSlot or brainrot.pedestalSlot == 0 then
			table.insert(filtered, brainrot)
		end
	end
	return filtered
end

-- ============================================================================
-- EQUIP / UNEQUIP LOGIC
-- ============================================================================

local function equipSlot(slotNumber)
	local hotbarInv = getHotbarInventory()
	if slotNumber == State.selectedSlot then
		-- Deselect (unequip)
		State.selectedSlot = 0
		State.equippedBrainrotId = ""
		EquipBrainrot:FireServer("")
	else
		local brainrot = hotbarInv[slotNumber]
		if brainrot then
			State.selectedSlot = slotNumber
			State.equippedBrainrotId = brainrot.id
			EquipBrainrot:FireServer(brainrot.id)
		end
	end
end

-- ============================================================================
-- HOTBAR REFRESH
-- ============================================================================

local function RefreshHotbar()
	-- Clear existing slots
	for _, child in ipairs(HotbarFrame:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	hotbarSlots = {}

	-- Only show brainrots NOT placed on pedestals
	local hotbarInv = getHotbarInventory()

	updateHotbarPosition(hotbarInv)

	local displayCount = math.min(#hotbarInv, MAX_HOTBAR_SLOTS)
	if displayCount < 1 then
		-- Show at least one empty slot
		displayCount = 1
	end

	for i = 1, displayCount do
		local brainrot = hotbarInv[i]
		local isSelected = (i == State.selectedSlot)

		local slot = Instance.new("TextButton")
		slot.Name = "HotbarSlot_" .. i
		slot.Size = UDim2.new(0, HOTBAR_SLOT_SIZE, 0, HOTBAR_SLOT_SIZE)
		slot.Position = UDim2.new(0, (i - 1) * (HOTBAR_SLOT_SIZE + HOTBAR_SLOT_PADDING), 0, 16)
		slot.BackgroundColor3 = isSelected and Colors.SlotSelected or Colors.SlotBG
		slot.BackgroundTransparency = isSelected and 0 or 0.15
		slot.BorderSizePixel = 0
		slot.Text = ""
		slot.AutoButtonColor = false
		slot.ZIndex = 6
		slot.Parent = HotbarFrame

		local slotCorner = Instance.new("UICorner")
		slotCorner.CornerRadius = UDim.new(0, 8)
		slotCorner.Parent = slot

		-- Border — rarity color if filled, dim gray if empty
		local slotStroke = Instance.new("UIStroke")
		if brainrot then
			slotStroke.Color = isSelected and Colors.GoldBright or GetRarityColor(brainrot.rarity)
			slotStroke.Thickness = isSelected and 3 or 2
		else
			slotStroke.Color = Color3.fromRGB(60, 55, 75)
			slotStroke.Thickness = 1
		end
		slotStroke.Parent = slot

		-- Number label (top-left)
		local numLabel = Instance.new("TextLabel")
		numLabel.Name = "Number"
		numLabel.Size = UDim2.new(0, 16, 0, 16)
		numLabel.Position = UDim2.new(0, 3, 0, 2)
		numLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		numLabel.BackgroundTransparency = 0.4
		numLabel.Text = tostring(i)
		numLabel.TextSize = 11
		numLabel.TextColor3 = isSelected and Colors.GoldBright or Colors.Dim
		numLabel.Font = Enum.Font.GothamBold
		numLabel.ZIndex = 8
		numLabel.Parent = slot

		local numCorner = Instance.new("UICorner")
		numCorner.CornerRadius = UDim.new(0, 4)
		numCorner.Parent = numLabel

		if brainrot then
			-- Brainrot image
			local img = Instance.new("ImageLabel")
			img.Name = "Icon"
			img.Size = UDim2.new(0, 42, 0, 42)
			img.Position = UDim2.new(0.5, -21, 0.5, -24)
			img.BackgroundTransparency = 1
			img.Image = tostring(brainrot.imageId or "")
			img.ZIndex = 7
			img.Parent = slot

			-- Short name at bottom
			local nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "BrainrotName"
			nameLabel.Size = UDim2.new(1, -4, 0, 12)
			nameLabel.Position = UDim2.new(0, 2, 1, -14)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = string.sub(brainrot.name, 1, 10)
			nameLabel.TextSize = 8
			nameLabel.TextColor3 = Colors.Dim
			nameLabel.Font = Enum.Font.GothamMedium
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nameLabel.ZIndex = 8
			nameLabel.Parent = slot

			-- Pedestal indicator (green dot if assigned)
			if brainrot.pedestalSlot and brainrot.pedestalSlot > 0 then
				local dot = Instance.new("Frame")
				dot.Name = "PedestalDot"
				dot.Size = UDim2.new(0, 10, 0, 10)
				dot.Position = UDim2.new(1, -13, 0, 3)
				dot.BackgroundColor3 = Colors.Green
				dot.ZIndex = 9
				dot.Parent = slot

				local dotCorner = Instance.new("UICorner")
				dotCorner.CornerRadius = UDim.new(1, 0)
				dotCorner.Parent = dot
			end

			-- Income text (small green text)
			local incomeLabel = Instance.new("TextLabel")
			incomeLabel.Name = "Income"
			incomeLabel.Size = UDim2.new(1, 0, 0, 10)
			incomeLabel.Position = UDim2.new(0, 0, 0.5, 14)
			incomeLabel.BackgroundTransparency = 1
			incomeLabel.Text = FormatMoney(brainrot.incomePerMin) .. "/m"
			incomeLabel.TextSize = 7
			incomeLabel.TextColor3 = Colors.Green
			incomeLabel.Font = Enum.Font.GothamMedium
			incomeLabel.ZIndex = 8
			incomeLabel.Parent = slot
		end

		-- Click handler
		local slotIndex = i
		slot.MouseButton1Click:Connect(function()
			local currentHotbar = getHotbarInventory()
			if currentHotbar[slotIndex] then
				equipSlot(slotIndex)
				RefreshHotbar()
			end
		end)

		hotbarSlots[i] = slot
	end

	-- Income indicator above hotbar
	local incomeText = Instance.new("TextLabel")
	incomeText.Name = "IncomeIndicator"
	incomeText.Size = UDim2.new(1, 0, 0, 14)
	incomeText.Position = UDim2.new(0, 0, 0, 0)
	incomeText.BackgroundTransparency = 1
	incomeText.Text = FormatMoney(State.incomePerMin) .. "/min income"
	incomeText.TextSize = 10
	incomeText.TextColor3 = Colors.Green
	incomeText.Font = Enum.Font.GothamBold
	incomeText.ZIndex = 6
	incomeText.Parent = HotbarFrame

	-- "More..." label if unplaced inventory > 9
	if #hotbarInv > MAX_HOTBAR_SLOTS then
		local moreLabel = Instance.new("TextLabel")
		moreLabel.Name = "MoreLabel"
		moreLabel.Size = UDim2.new(1, 0, 0, 12)
		moreLabel.Position = UDim2.new(0, 0, 1, -2)
		moreLabel.BackgroundTransparency = 1
		moreLabel.Text = "+" .. (#hotbarInv - MAX_HOTBAR_SLOTS) .. " more (press I)"
		moreLabel.TextSize = 9
		moreLabel.TextColor3 = Colors.Dim
		moreLabel.Font = Enum.Font.GothamMedium
		moreLabel.ZIndex = 6
		moreLabel.Parent = HotbarFrame
	end
end

-- ============================================================================
-- KEYBOARD INPUT (1-9 to select slots, I to open inventory)
-- ============================================================================

local NUMBER_KEYS = {
	[Enum.KeyCode.One]   = 1,
	[Enum.KeyCode.Two]   = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four]  = 4,
	[Enum.KeyCode.Five]  = 5,
	[Enum.KeyCode.Six]   = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine]  = 9,
}

-- Forward declare panels so keyboard handler can reference them
local InventoryPanel
local ShopPanel

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	local keyCode = input.KeyCode
	local slotNum = NUMBER_KEYS[keyCode]

	if slotNum then
		local hotbarInv = getHotbarInventory()
		if slotNum <= #hotbarInv then
			equipSlot(slotNum)
			RefreshHotbar()
		end
	elseif keyCode == Enum.KeyCode.I then
		-- Toggle inventory panel
		if InventoryPanel and InventoryPanel.Visible then
			TweenElement(InventoryPanel, {Position = UDim2.new(0.5, -275, 0.5, -500)}, 0.3)
			task.delay(0.3, function()
				InventoryPanel.Visible = false
			end)
		elseif InventoryPanel then
			InventoryPanel.Visible = true
			TweenElement(InventoryPanel, {Position = UDim2.new(0.5, -275, 0.5, -250)}, 0.3)
			RequestInventory:FireServer()
		end
	end
end)

