			AssignPedestal:FireServer(brainrot.id, 0)
		end)
		removeButton.Name = "RemoveButton"
		removeButton.Size = UDim2.new(1, 0, 0, 14)
	else
		local assignButton = CreateButton(buttonContainer, "ASSIGN TO PEDESTAL", 9, Colors.Blue, Colors.White, function()
