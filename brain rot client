-- ============================================================================
-- INVENTORY REFRESH
-- ============================================================================

local function RefreshInventoryUI()
	-- Clear existing cards
	for _, child in ipairs(InventoryScrollFrame:GetChildren()) do
		if child:IsA("Frame") and child.Name:find("BrainrotCard") then
			child:Destroy()
		end
	end

	-- Create new cards
	for i, brainrot in ipairs(State.inventory) do
		CreateInventoryCard(brainrot, i)
	end

	-- Update canvas size
	local gridHeight = math.ceil(#State.inventory / 3) * 190
	InventoryScrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(0, gridHeight))

	-- Update stats
	local totalOwned = #State.inventory
	local totalIncome = 0
	local pedestalCount = 0

	for _, brainrot in ipairs(State.inventory) do
		if brainrot.pedestalSlot and brainrot.pedestalSlot > 0 then
			totalIncome = totalIncome + brainrot.incomePerMin
			pedestalCount = pedestalCount + 1
		end
	end

	StatTotalOwned.Text = "Owned: " .. totalOwned
	StatIncomePerMin.Text = "Income: " .. FormatMoney(totalIncome) .. "/min"
	StatPedestalSlots.Text = "Pedestals: " .. pedestalCount .. "/" .. State.maxSlots
	State.incomePerMin = totalIncome

	-- Also refresh hotbar
	RefreshHotbar()
end

