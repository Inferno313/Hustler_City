local function ShowPickupToastUI(brainrotName, rarity, price)
	local toast = CreatePanel(ScreenGui, "PickupToast")
	toast.Size = UDim2.new(0, 300, 0, 95)
	toast.Position = UDim2.new(0.5, -150, 0, -110)
	toast.ZIndex = 20

	local toastPadding = Instance.new("UIPadding")
	toastPadding.PaddingTop = UDim.new(0, 10)
	toastPadding.PaddingBottom = UDim.new(0, 10)
	toastPadding.PaddingLeft = UDim.new(0, 10)
	toastPadding.PaddingRight = UDim.new(0, 10)
	toastPadding.Parent = toast

	local toastLayout = Instance.new("UIListLayout")
	toastLayout.Padding = UDim.new(0, 4)
	toastLayout.FillDirection = Enum.FillDirection.Vertical
	toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	toastLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	toastLayout.Parent = toast

	-- Check if "can't afford" signal
	if price == -1 then
		local failLabel = CreateLabel(toast, "NOT ENOUGH CASH!", 16, Colors.Red, Enum.Font.GothamBold)
		failLabel.Size = UDim2.new(1, 0, 0, 20)

		local nameLabel = CreateLabel(toast, brainrotName, 14, Colors.White, Enum.Font.GothamBold)
		nameLabel.Size = UDim2.new(1, 0, 0, 18)

		local rarityLabel = CreateLabel(toast, "★ " .. rarity .. " ★", 12, GetRarityColor(rarity), Enum.Font.GothamBold)
		rarityLabel.Size = UDim2.new(1, 0, 0, 16)
	elseif rarity == "collect" then
		-- Income collected from a casino tile
		local collectLabel = CreateLabel(toast, "COLLECTED!", 16, Colors.Green, Enum.Font.GothamBold)
		collectLabel.Size = UDim2.new(1, 0, 0, 20)

		local nameLabel = CreateLabel(toast, brainrotName, 14, Colors.White, Enum.Font.GothamBold)
		nameLabel.Size = UDim2.new(1, 0, 0, 18)

		if price and price > 0 then
			local amountLabel = CreateLabel(toast, "+" .. FormatMoney(price), 14, Colors.Green, Enum.Font.GothamBold)
			amountLabel.Size = UDim2.new(1, 0, 0, 18)
		end
	else
		local collectedLabel = CreateLabel(toast, "PURCHASED!", 16, Colors.GoldBright, Enum.Font.GothamBold)
		collectedLabel.Size = UDim2.new(1, 0, 0, 20)

		local nameLabel = CreateLabel(toast, brainrotName, 14, Colors.White, Enum.Font.GothamBold)
		nameLabel.Size = UDim2.new(1, 0, 0, 18)

		local rarityLabel = CreateLabel(toast, "★ " .. rarity .. " ★", 12, GetRarityColor(rarity), Enum.Font.GothamBold)
		rarityLabel.Size = UDim2.new(1, 0, 0, 16)

		if price and price > 0 then
			local priceLabel = CreateLabel(toast, "-" .. FormatMoney(price), 12, Colors.Red, Enum.Font.GothamBold)
			priceLabel.Size = UDim2.new(1, 0, 0, 16)
		end
	end

	-- Slide in
	TweenElement(toast, {Position = UDim2.new(0.5, -150, 0, 20)}, 0.4)

	-- Wait and slide out
	task.delay(2.5, function()
		TweenElement(toast, {Position = UDim2.new(0.5, -150, 0, -110)}, 0.4)
		task.delay(0.5, function()
			if toast.Parent then toast:Destroy() end
		end)
	end)
end

