-- ============================================================================
-- EVENT HANDLERS
-- ============================================================================

-- Inventory sync from server
SyncInventory.OnClientEvent:Connect(function(inventory, maxSlots)
	State.inventory = inventory or {}
	if maxSlots then
		State.maxSlots = maxSlots
	end

	-- If selected slot is out of bounds OR equipped brainrot got placed, deselect
	local hotbarInv = getHotbarInventory()
	local shouldDeselect = false
	if State.selectedSlot > #hotbarInv then
		shouldDeselect = true
	elseif State.equippedBrainrotId ~= "" then
		-- Check if the equipped brainrot is still in the hotbar (not placed)
		local stillInHotbar = false
		for _, b in ipairs(hotbarInv) do
			if b.id == State.equippedBrainrotId then
				stillInHotbar = true
				break
			end
		end
		if not stillInHotbar then
			shouldDeselect = true
		end
	end
	if shouldDeselect then
		State.selectedSlot = 0
		State.equippedBrainrotId = ""
		EquipBrainrot:FireServer("")
	end

	RefreshInventoryUI()
end)

-- Pending income sync from server (used for hotbar income display)
SyncPendingIncome.OnClientEvent:Connect(function(pendingAmount, incomePerMin)
	State.pendingIncome = pendingAmount or 0

	if incomePerMin then
		State.incomePerMin = incomePerMin
	end

	-- Refresh hotbar to update income indicator
	RefreshHotbar()
end)

-- Shop data sync from server
SyncShopData.OnClientEvent:Connect(function(shopData)
	State.shopData = shopData or {}
	RefreshShopUI()
end)

-- Pickup toast from server
ShowPickupToast.OnClientEvent:Connect(function(brainrotName, rarity, price)
	ShowPickupToastUI(brainrotName, rarity, price)
end)

-- Server tells us to open the shop (triggered by Brainrot Dealer NPC)
OpenShopUI.OnClientEvent:Connect(function()
	ShopPanel.Visible = true
	TweenElement(ShopPanel, {Position = UDim2.new(0.5, -250, 0.5, -275)}, 0.3)
	RequestShopData:FireServer()
end)

-- Server tells us to open inventory
OpenInventoryUI.OnClientEvent:Connect(function()
	InventoryPanel.Visible = true
	TweenElement(InventoryPanel, {Position = UDim2.new(0.5, -275, 0.5, -250)}, 0.3)
	RequestInventory:FireServer()
end)

