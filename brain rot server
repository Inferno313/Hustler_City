--[[
	BrainrotServer.lua
	Main server-side script that manages the Brainrot game server
	Place in: ServerScriptService

	UPDATED: Walk-over collection (no ProximityPrompt), holdable inventory slots
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataManager = require(ServerScriptService:WaitForChild("DataStoreManager"))
local BrainrotConfig = require(ServerScriptService:WaitForChild("BrainrotConfig"))
local BrainrotService

-- ═══════════════════════════════════════════════════════════════════════════
-- INITIALIZATION
-- ═══════════════════════════════════════════════════════════════════════════

print("[BrainrotServer] Starting initialization...")

-- Wait for BrainrotService to be available
repeat
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	if servicesFolder then
		local bsModule = servicesFolder:FindFirstChild("BrainrotService")
		if bsModule then
			BrainrotService = require(bsModule)
		end
	end
	if not BrainrotService then task.wait(0.1) end
until BrainrotService

print("[BrainrotServer] BrainrotService loaded")

-- ═══════════════════════════════════════════════════════════════════════════
-- CREATE REMOTE EVENTS
-- ═══════════════════════════════════════════════════════════════════════════

local EventsFolder = ReplicatedStorage:FindFirstChild("BrainrotEvents")
if not EventsFolder then
	EventsFolder = Instance.new("Folder")
	EventsFolder.Name = "BrainrotEvents"
	EventsFolder.Parent = ReplicatedStorage
end

local function getOrCreateEvent(name)
	local event = EventsFolder:FindFirstChild(name)
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = EventsFolder
	end
	return event
end

-- Server → Client events
local SyncInventory      = getOrCreateEvent("SyncInventory")
local SyncPendingIncome  = getOrCreateEvent("SyncPendingIncome")
local ShowPickupToast    = getOrCreateEvent("ShowPickupToast")
local OpenShopUI         = getOrCreateEvent("OpenShopUI")
local OpenInventoryUI    = getOrCreateEvent("OpenInventoryUI")
local SyncShopData       = getOrCreateEvent("SyncShopData")

-- Client → Server events
local CollectStreetBrainrot = getOrCreateEvent("CollectStreetBrainrot")
local BuyBrainrot           = getOrCreateEvent("BuyBrainrot")
local AssignPedestal        = getOrCreateEvent("AssignPedestal")
local CollectIncome         = getOrCreateEvent("CollectIncome")
local RequestInventory      = getOrCreateEvent("RequestInventory")
local RequestShopData       = getOrCreateEvent("RequestShopData")
local RequestPendingIncome  = getOrCreateEvent("RequestPendingIncome")
local EquipBrainrot         = getOrCreateEvent("EquipBrainrot")

print("[BrainrotServer] RemoteEvents created/loaded")

-- ═══════════════════════════════════════════════════════════════════════════
-- EQUIPPED BRAINROT TRACKING (which brainrot each player is "holding")
-- ═══════════════════════════════════════════════════════════════════════════

local EquippedModels = {}  -- player -> Model in workspace attached to character
local EquippedBrainrotIds = {} -- player -> brainrotId string (what they're "holding")

local function clearEquippedModel(player)
	if EquippedModels[player] then
		pcall(function() EquippedModels[player]:Destroy() end)
		EquippedModels[player] = nil
	end
end

local function spawnEquippedModel(player, brainrotId)
	clearEquippedModel(player)
	if not brainrotId or brainrotId == "" then return end

	local cfg = BrainrotConfig.getById(brainrotId)
	if not cfg then return end

	local character = player.Character
	if not character then return end
	local head = character:FindFirstChild("Head")
	if not head then return end

	-- Create a small brainrot model floating above the player's head
	local model = Instance.new("Model")
	model.Name = "EquippedBrainrot"

	-- Try loading a real 3D mesh
	local meshClone = BrainrotConfig.loadMesh(cfg.accessoryId)

	local display
	if meshClone then
		display = meshClone
		display.Name = "BrainrotDisplay"
		display.Anchored = false
		display.CanCollide = false
		display.Size = Vector3.new(1.5, 1.5, 1.5)
		display.Massless = true
		display.Parent = model
	else
		-- Fallback: plain cube with decals
		display = Instance.new("Part")
		display.Name = "BrainrotDisplay"
		display.Anchored = false
		display.CanCollide = false
		display.Size = Vector3.new(1.5, 1.5, 1.5)
		display.Color = cfg.modelColor or Color3.fromRGB(200, 170, 60)
		display.Material = Enum.Material.SmoothPlastic
		display.Transparency = 0
		display.Massless = true
		display.TopSurface = Enum.SurfaceType.Smooth
		display.BottomSurface = Enum.SurfaceType.Smooth
		display.Parent = model

		for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right}) do
			local decal = Instance.new("Decal")
			decal.Face = face
			decal.Texture = cfg.imageId or ""
			decal.Parent = display
		end
	end

	-- Weld to head, offset above
	local weld = Instance.new("Weld")
	weld.Part0 = head
	weld.Part1 = display
	weld.C0 = CFrame.new(0, 2.2, 0)  -- float above head
	weld.Parent = display

	-- Rarity glow ring
	local rarityInfo = BrainrotConfig.Rarities[cfg.rarity]
	local rarityColor = rarityInfo and rarityInfo.Color or Color3.fromRGB(180, 180, 180)

	local ring = Instance.new("Part")
	ring.Name = "RarityRing"
	ring.Anchored = false
	ring.CanCollide = false
	ring.Size = Vector3.new(2, 0.1, 2)
	ring.Color = rarityColor
	ring.Material = Enum.Material.Neon
	ring.Massless = true
	ring.Transparency = 0.3
	ring.Parent = model

	local ringWeld = Instance.new("Weld")
	ringWeld.Part0 = display
	ringWeld.Part1 = ring
	ringWeld.C0 = CFrame.new(0, -0.8, 0)
	ringWeld.Parent = ring

	-- Billboard with name
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 150, 0, 30)
	bb.StudsOffset = Vector3.new(0, 1.2, 0)
	bb.AlwaysOnTop = false
	bb.Parent = display

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = cfg.name
	nameLabel.TextColor3 = rarityColor
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.Parent = bb

	model.PrimaryPart = display
	model.Parent = character

	EquippedModels[player] = model
end

-- Handle equip events from client
EquipBrainrot.OnServerEvent:Connect(function(player, brainrotId)
	-- Validate that the player actually owns this brainrot
	if brainrotId and brainrotId ~= "" then
		local data = DataManager:GetData(player)
		if not data or not data.Brainrots then return end
		local found = false
		for _, entry in ipairs(data.Brainrots) do
			if entry.id == brainrotId then
				found = true
				break
			end
		end
		if not found then return end
		EquippedBrainrotIds[player] = brainrotId
	else
		EquippedBrainrotIds[player] = nil
	end

	spawnEquippedModel(player, brainrotId)
end)

-- Clean up on character removal
Players.PlayerAdded:Connect(function(player)
	player.CharacterRemoving:Connect(function()
		clearEquippedModel(player)
	end)
end)

-- Share the equipped-brainrot tracker with BrainrotService so pedestal ProximityPrompts
-- can check what the player is holding and auto-place it
BrainrotService.setEquippedTracker(EquippedBrainrotIds, function(player)
	-- After placing a brainrot, unequip the held model above the player's head
	EquippedBrainrotIds[player] = nil
	spawnEquippedModel(player, "")
	-- Client will auto-deselect when it receives the SyncInventory update
	-- (the placed brainrot will have pedestalSlot > 0 so it leaves the hotbar)
end)

