print("[BrainrotServer] Setting up event handlers...")

-- CollectIncome handler
CollectIncome.OnServerEvent:Connect(function(player)
	local ok, err = pcall(function()
		local amount = BrainrotService.collectIncome(player)
		local pending, ipm = BrainrotService.getPendingIncome(player)
		SyncPendingIncome:FireClient(player, pending, ipm)

		local inventory, maxSlots = BrainrotService.getInventory(player)
		SyncInventory:FireClient(player, inventory, maxSlots)
	end)

	if not ok then
		warn("[BrainrotServer] Error collecting income for", player.Name, ":", err)
	end
end)

-- BuyBrainrot handler
BuyBrainrot.OnServerEvent:Connect(function(player, brainrotId)
	local ok, err = pcall(function()
		local success, msg = BrainrotService.buyBrainrot(player, brainrotId)

		local inventory, maxSlots = BrainrotService.getInventory(player)
		SyncInventory:FireClient(player, inventory, maxSlots)

		local pending, ipm = BrainrotService.getPendingIncome(player)
		SyncPendingIncome:FireClient(player, pending, ipm)
	end)

	if not ok then
		warn("[BrainrotServer] Error buying brainrot for", player.Name, ":", err)
	end
end)

-- AssignPedestal handler
AssignPedestal.OnServerEvent:Connect(function(player, brainrotId, slot)
	local ok, err = pcall(function()
		local data = DataManager:GetData(player)
		if not data or not data.Brainrots then return end

		local inventoryIndex = nil
		for i, entry in ipairs(data.Brainrots) do
			if entry.id == brainrotId then
				if slot == 0 then
					if entry.pedestalSlot and entry.pedestalSlot > 0 then
						inventoryIndex = i
						break
					end
				else
					if (entry.pedestalSlot or 0) == 0 then
						inventoryIndex = i
						break
					end
				end
			end
		end

		if not inventoryIndex then
			for i, entry in ipairs(data.Brainrots) do
				if entry.id == brainrotId then
					inventoryIndex = i
					break
				end
			end
		end

		if inventoryIndex then
			BrainrotService.assignToPedestal(player, inventoryIndex, slot or 0)
		end

		local inventory, maxSlots = BrainrotService.getInventory(player)
		SyncInventory:FireClient(player, inventory, maxSlots)
	end)

	if not ok then
		warn("[BrainrotServer] Error assigning pedestal for", player.Name, ":", err)
	end
end)

-- RequestInventory handler
RequestInventory.OnServerEvent:Connect(function(player)
	local ok, err = pcall(function()
		local inventory, maxSlots = BrainrotService.getInventory(player)
		SyncInventory:FireClient(player, inventory, maxSlots)
	end)

	if not ok then
		warn("[BrainrotServer] Error syncing inventory for", player.Name, ":", err)
	end
end)

-- RequestShopData handler
RequestShopData.OnServerEvent:Connect(function(player)
	local ok, err = pcall(function()
		local shopBrainrots = BrainrotConfig.getShopBrainrots()

		local shopData = {}
		for _, br in ipairs(shopBrainrots) do
			table.insert(shopData, {
				id           = br.id,
				name         = br.name,
				rarity       = br.rarity,
				incomePerMin = br.incomePerMin,
				imageId      = br.imageId,
				price        = br.shopPrice,
				description  = br.description,
			})
		end

		SyncShopData:FireClient(player, shopData)

		local inventory, maxSlots = BrainrotService.getInventory(player)
		SyncInventory:FireClient(player, inventory, maxSlots)
	end)

	if not ok then
		warn("[BrainrotServer] Error syncing shop data for", player.Name, ":", err)
	end
end)

-- RequestPendingIncome handler
RequestPendingIncome.OnServerEvent:Connect(function(player)
	local ok, err = pcall(function()
		local pending, ipm = BrainrotService.getPendingIncome(player)
		SyncPendingIncome:FireClient(player, pending, ipm)
	end)

	if not ok then
		warn("[BrainrotServer] Error syncing pending income for", player.Name, ":", err)
	end
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- INCOME TICKER (ticks income every 10 seconds, updates tile displays every 2 seconds)
-- ═══════════════════════════════════════════════════════════════════════════

local function startIncomeTicker()
	print("[BrainrotServer] Income ticker started")

	while true do
		task.wait(10)  -- Tick income every 10 seconds for responsive tile updates

		for _, player in ipairs(Players:GetPlayers()) do
			local ok, err = pcall(function()
				BrainrotService.tickIncome(player)
				BrainrotService.updateTileDisplays(player)

				local pending, ipm = BrainrotService.getPendingIncome(player)
				SyncPendingIncome:FireClient(player, pending, ipm)
			end)

			if not ok then
				warn("[BrainrotServer] Error ticking income for", player.Name, ":", err)
			end
		end
	end
end

-- Faster tile display refresh (every 2 seconds, updates the cash label on floor tiles)
local function startTileDisplayUpdater()
	print("[BrainrotServer] Tile display updater started")

	while true do
		task.wait(2)

		for _, player in ipairs(Players:GetPlayers()) do
			pcall(function()
				BrainrotService.updateTileDisplays(player)
			end)
		end
	end
end

-- ═══════════════════════════════════════════════════════════════════════════
-- CLEANUP ON PLAYER LEAVE
-- ═══════════════════════════════════════════════════════════════════════════

Players.PlayerRemoving:Connect(function(player)
	clearEquippedModel(player)
	EquippedBrainrotIds[player] = nil
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- STARTUP
-- ═══════════════════════════════════════════════════════════════════════════

task.spawn(startStreetSpawner)
task.spawn(startIncomeTicker)
task.spawn(startTileDisplayUpdater)

print("[BrainrotServer] Server fully initialized and running!")
