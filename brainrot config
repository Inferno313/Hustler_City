	BrainrotConfig.lua  (ModuleScript)
	Place in ServerScriptService as "BrainrotConfig"

	Defines every brainrot: name, rarity, income, images, shop price, spawn weight.
	Require this from both BrainrotService and BrainrotServer.
--]]

local InsertService = game:GetService("InsertService")

local BrainrotConfig = {}

-- ═══════════════════════════════════════════════════════════════════════════
-- MESH LOADING (shared by BrainrotServer + BrainrotService)
-- Loads UGC accessory models via InsertService, caches the template MeshPart
-- ═══════════════════════════════════════════════════════════════════════════
local _meshCache = {}  -- { [accessoryId] = MeshPart template  |  false }

--- Try to load the 3D mesh for a brainrot from the Roblox catalog.
--- Returns a CLONE of the cached MeshPart, or nil if no mesh is available.
function BrainrotConfig.loadMesh(accessoryId)
	if not accessoryId then return nil end

	-- Return cached result (false = previously failed, don't retry)
	if _meshCache[accessoryId] ~= nil then
		if _meshCache[accessoryId] == false then return nil end
		return _meshCache[accessoryId]:Clone()
	end

	local ok, assetModel = pcall(function()
		return InsertService:LoadAsset(accessoryId)
	end)

	if not ok or not assetModel then
		warn("[BrainrotConfig] Failed to load accessory " .. tostring(accessoryId))
		_meshCache[accessoryId] = false
		return nil
	end

	-- UGC accessories: Model > Accessory > Handle (MeshPart)
	local meshPart = nil
	for _, desc in ipairs(assetModel:GetDescendants()) do
		if desc:IsA("MeshPart") then
			meshPart = desc
			break
		end
	end

	-- Fallback: Part with SpecialMesh inside
	if not meshPart then
		for _, desc in ipairs(assetModel:GetDescendants()) do
			if desc:IsA("BasePart") and desc:FindFirstChildWhichIsA("SpecialMesh") then
				meshPart = desc
				break
			end
		end
	end

	if meshPart then
		meshPart.Parent = nil  -- detach from loaded model tree
		meshPart.Anchored = true
		meshPart.CanCollide = false
		_meshCache[accessoryId] = meshPart
		assetModel:Destroy()
		return meshPart:Clone()
	end

	warn("[BrainrotConfig] No MeshPart found in accessory " .. tostring(accessoryId))
	assetModel:Destroy()
	_meshCache[accessoryId] = false
	return nil
end

