-- ═══════════════════════════════════════════════════════════════════════════
-- LOOKUP HELPERS
-- ═══════════════════════════════════════════════════════════════════════════

-- Quick lookup by id
local _byId = {}
for _, br in ipairs(BrainrotConfig.Brainrots) do
	_byId[br.id] = br
end

function BrainrotConfig.getById(id)
	return _byId[id]
end

-- Get all street-spawnable brainrots with cumulative weights
local _streetPool = {}
local _streetTotalWeight = 0
for _, br in ipairs(BrainrotConfig.Brainrots) do
	if br.streetSpawn and br.spawnWeight > 0 then
		_streetTotalWeight = _streetTotalWeight + br.spawnWeight
		table.insert(_streetPool, { brainrot = br, cumWeight = _streetTotalWeight })
	end
end

function BrainrotConfig.getRandomStreetBrainrot()
	local roll = math.random() * _streetTotalWeight
	for _, entry in ipairs(_streetPool) do
		if roll <= entry.cumWeight then
			return entry.brainrot
		end
	end
	return _streetPool[#_streetPool].brainrot
end

-- Get all shop brainrots (sorted by price)
function BrainrotConfig.getShopBrainrots()
	local shop = {}
	for _, br in ipairs(BrainrotConfig.Brainrots) do
		table.insert(shop, br)
	end
	table.sort(shop, function(a, b) return a.shopPrice < b.shopPrice end)
	return shop
end

return BrainrotConfig
