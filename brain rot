--[[
	BrainrotService.lua  (ModuleScript)
	Place in ServerScriptService/Services/BrainrotService

	Core server logic for the brainrot collection system:
	  • Add / remove brainrots from a player's inventory
	  • Assign / unassign brainrots to pedestal slots (press E)
	  • Per-brainrot income accumulation
	  • Spawn 3D brainrot display models on casino pedestals
	  • Spawn income collection tiles in front of each pedestal
	  • Walk-over tile collection (like Steal a Brainrot)

	UPDATED: Per-brainrot income tiles, $/sec display, walk-over collection
--]]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local Players             = game:GetService("Players")
local Workspace           = game:GetService("Workspace")

local BrainrotService = {}

local DataManager, BrainrotConfig, LotService

-- Track active income tiles so we can update their display text
-- Structure: { [player] = { [pedestalSlot] = { tile=Part, label=TextLabel, brainrotId=string, accumulated=number } } }
local ActiveIncomeTiles = {}

-- Reference to BrainrotServer's equipped brainrot ID tracker (set via setEquippedTracker)
local EquippedBrainrotIds = {}
-- Callback to unequip a brainrot after placing (set via setEquippedTracker)
local OnPlacedCallback = nil

-- ═══════════════════════════════════════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════════════════════════════════════
function BrainrotService.init(dm, config, ls)
	DataManager   = dm
	BrainrotConfig = config
	LotService    = ls
	print("[BrainrotService] Initialized")
end

--- Called by BrainrotServer to share the equipped-brainrot tracker
--- @param equippedTable table  { [player] = brainrotId }
--- @param onPlaced function(player)  called after placing to unequip the held brainrot
function BrainrotService.setEquippedTracker(equippedTable, onPlaced)
	EquippedBrainrotIds = equippedTable
	OnPlacedCallback = onPlaced
end

-- ═══════════════════════════════════════════════════════════════════════════
-- HELPERS
-- ═══════════════════════════════════════════════════════════════════════════

local function getPlayerData(player)
	local data = DataManager:GetData(player)
	if not data then return nil end
	if not data.Brainrots then data.Brainrots = {} end
	if not data.BrainrotPendingIncome then data.BrainrotPendingIncome = 0 end
	if not data.BrainrotLastTick then data.BrainrotLastTick = os.time() end
	-- ALWAYS recalculate slots from CasinoLevel (don't cache stale 0)
	data.BrainrotSlots = BrainrotConfig.SlotsPerLevel[data.CasinoLevel or 0] or 0
	-- Per-brainrot pending income (keyed by inventory index)
	if not data.BrainrotTileIncome then data.BrainrotTileIncome = {} end
	return data
end

local function formatCash(amount)
	if amount >= 1000000 then
		return string.format("$%.1fM", amount / 1000000)
	elseif amount >= 1000 then
		return string.format("$%.1fK", amount / 1000)
	else
		return "$" .. tostring(math.floor(amount))
	end
end

-- Calculate total income per minute from all assigned (slotted) brainrots
local function calcIncomePerMin(data)
	local total = 0
	for _, entry in ipairs(data.Brainrots) do
		if entry.pedestalSlot and entry.pedestalSlot > 0 then
			local cfg = BrainrotConfig.getById(entry.id)
			if cfg then
				total = total + cfg.incomePerMin
			end
		end
	end
	return total
end

-- ═══════════════════════════════════════════════════════════════════════════
-- PER-BRAINROT INCOME ACCUMULATION
-- ═══════════════════════════════════════════════════════════════════════════

--- Tick income for each individual brainrot on a pedestal
function BrainrotService.tickIncome(player)
	local data = getPlayerData(player)
	if not data then return end

	local now = os.time()
	local elapsed = now - (data.BrainrotLastTick or now)
	if elapsed <= 0 then
		data.BrainrotLastTick = now
		return
	end

	-- Cap offline income
	local maxSeconds = (BrainrotConfig.Income.MaxOfflineMinutes or 480) * 60
	elapsed = math.min(elapsed, maxSeconds)

	-- Accumulate income PER brainrot on a pedestal
	for i, entry in ipairs(data.Brainrots) do
		if entry.pedestalSlot and entry.pedestalSlot > 0 then
			local cfg = BrainrotConfig.getById(entry.id)
			if cfg and cfg.incomePerMin > 0 then
				local earned = math.floor(cfg.incomePerMin * (elapsed / 60))
				local key = tostring(i)  -- inventory index as string key
				data.BrainrotTileIncome[key] = (data.BrainrotTileIncome[key] or 0) + earned
			end
		end
	end

	-- Also keep the global pending for backward compat
	local ipm = calcIncomePerMin(data)
	if ipm > 0 then
		local earned = math.floor(ipm * (elapsed / 60))
		data.BrainrotPendingIncome = (data.BrainrotPendingIncome or 0) + earned
	end

	data.BrainrotLastTick = now
end

--- Collect income from a SPECIFIC brainrot tile (by inventory index)
function BrainrotService.collectTileIncome(player, inventoryIndex)
	local data = getPlayerData(player)
	if not data then return 0 end

	local key = tostring(inventoryIndex)
	local pending = data.BrainrotTileIncome[key] or 0
	if pending <= 0 then return 0 end

	-- Add to cash
	data.Cash = (data.Cash or 0) + pending
	data.TotalEarned = (data.TotalEarned or 0) + pending
	data.BrainrotTileIncome[key] = 0

	-- Also reduce from global pending (keep in sync)
	data.BrainrotPendingIncome = math.max(0, (data.BrainrotPendingIncome or 0) - pending)

	-- Sync HUD cash
	pcall(function()
		local Events = ReplicatedStorage:FindFirstChild("Events")
		if Events then
			local updateCurrency = Events:FindFirstChild("UpdateCurrency")
			if updateCurrency then
				updateCurrency:FireClient(player, data.Cash)
			end
		end
	end)

	pcall(function() DataManager:CheckLevelUp(player) end)

	return pending
end

--- Collect ALL pending income at once (legacy fallback)
function BrainrotService.collectIncome(player)
	local data = getPlayerData(player)
	if not data then return 0 end

	BrainrotService.tickIncome(player)

	-- Collect all tile incomes
	local totalCollected = 0
	for key, amount in pairs(data.BrainrotTileIncome) do
		if amount > 0 then
			totalCollected = totalCollected + amount
			data.BrainrotTileIncome[key] = 0
		end
	end

	-- Also collect global pending
	local globalPending = data.BrainrotPendingIncome or 0
	if globalPending > totalCollected then
		totalCollected = globalPending  -- use the bigger number
	end

	if totalCollected <= 0 then return 0 end

	data.Cash = (data.Cash or 0) + totalCollected
	data.TotalEarned = (data.TotalEarned or 0) + totalCollected
	data.BrainrotPendingIncome = 0

	pcall(function()
		local Events = ReplicatedStorage:FindFirstChild("Events")
		if Events then
			local updateCurrency = Events:FindFirstChild("UpdateCurrency")
			if updateCurrency then
				updateCurrency:FireClient(player, data.Cash)
			end
		end
	end)

	pcall(function() DataManager:CheckLevelUp(player) end)

	print("[BrainrotService] " .. player.Name .. " collected $" .. totalCollected .. " brainrot income")
	return totalCollected
end

--- Get current pending income (for UI display)
function BrainrotService.getPendingIncome(player)
	local data = getPlayerData(player)
	if not data then return 0, 0 end

	local now = os.time()
	local elapsed = math.min(
		now - (data.BrainrotLastTick or now),
		(BrainrotConfig.Income.MaxOfflineMinutes or 480) * 60
	)
	local ipm = calcIncomePerMin(data)
	local liveIncome = math.floor(ipm * math.max(0, elapsed) / 60)

	return (data.BrainrotPendingIncome or 0) + liveIncome, ipm
end

--- Get tile income for a specific brainrot (by inventory index)
function BrainrotService.getTileIncome(player, inventoryIndex)
	local data = getPlayerData(player)
	if not data then return 0 end
	local key = tostring(inventoryIndex)
	return data.BrainrotTileIncome[key] or 0
end

