-- SEATING
-- ═══════════════════════════════════════════════════════════════════════════
SeatPlayer.OnClientEvent:Connect(function(tbl, seatName)
	currentTable   = tbl
	seatedSeatName = seatName

	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not hrp or not hum then return end

	savedCFrame = hrp.CFrame

	local seat = tbl:FindFirstChild(seatName)
	local surface = tbl:FindFirstChild("TableSurface")
	if seat and surface then
		local look = (surface.Position - seat.CFrame.Position).Unit
		look = Vector3.new(look.X, 0, look.Z).Unit
		local seatTop = seat.CFrame.Position + Vector3.new(0, 1, 0)
		hrp.CFrame = CFrame.new(seatTop, seatTop + look)
	end
	hum.Sit = true
end)

UnseatPlayer.OnClientEvent:Connect(function(tbl)
	if tbl ~= currentTable then return end
	local char = player.Character
	if char then
		local hum = char:FindFirstChild("Humanoid")
		if hum then hum.Sit = false end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and savedCFrame then task.wait(0.1); hrp.CFrame = savedCFrame end
	end
	currentTable = nil; seatedSeatName = nil; savedCFrame = nil; mySide = nil
end)

