-- COIN FLIP ANIMATION
-- ═══════════════════════════════════════════════════════════════════════════
PlayFlipAnim.OnClientEvent:Connect(function(tbl, landsSide, myPickedSide, p1Name, p2Name, betAmount)
	hideAll()
	flipPanel.Visible = true

	-- Setup portraits based on who picked what
	-- P1 is always on the left
	leftName.Text = p1Name
	rightName.Text = p2Name

	-- The landsSide tells us which image landed face-up on the coin
	-- myPickedSide tells this player which side they chose
	flipBetLabel.Text = "BET: " .. formatCash(betAmount)

	-- Set portrait images/labels
	leftImg.Image = TUNG_TUNG_ID
	leftSideLabel.Text = "TUNG TUNG"
	rightImg.Image = TRALALELO_ID
	rightSideLabel.Text = "TRALALELO"

	-- Reset strokes on the coin circles
	leftCoinBg:FindFirstChildOfClass("UIStroke").Color = P.Gold
	leftCoinBg:FindFirstChildOfClass("UIStroke").Thickness = 3
	rightCoinBg:FindFirstChildOfClass("UIStroke").Color = P.Gold
	rightCoinBg:FindFirstChildOfClass("UIStroke").Thickness = 3

	-- Reset coin to flat position (cylinder axis along X → rotate 90° Z to stand upright)
	coinPart.CFrame = CFrame.Angles(0, 0, math.rad(90))

	-- Determine total half-flips for result:
	-- Even = Right face (+X → +Y after orient) stays up = Tung Tung visible
	-- Odd  = Left face flipped up = Tralalelo visible
	local totalHalfFlips = (landsSide == "tung") and 14 or 15
	local ANIM_TIME = 4.0
	local TOSS_HEIGHT = 4.0    -- peak height of the coin toss

	local startTime = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local elapsed = tick() - startTime
		local t = math.clamp(elapsed / ANIM_TIME, 0, 1)

		if elapsed >= ANIM_TIME then
			conn:Disconnect()
			-- Final resting position: orient upright FIRST, then apply final flip rotation
			coinPart.CFrame = CFrame.new(0, 0, 0)
				* CFrame.Angles(totalHalfFlips * math.pi, 0, 0)
				* CFrame.Angles(0, 0, math.rad(90))
			return
		end

		-- Cubic ease-out for flip deceleration (fast start, slow finish)
		local eased = 1 - (1 - t)^3
		local flipAngle = eased * totalHalfFlips * math.pi

		-- Parabolic arc: coin goes up then comes back down
		local arc = TOSS_HEIGHT * math.sin(t * math.pi)

		-- Small Y wobble for visual interest (fades out)
		local wobble = math.sin(t * math.pi * 6) * (1 - t) * 0.3

		-- KEY FIX: Orient cylinder upright FIRST, then apply flip rotation around world X
		-- This makes the coin tumble forward/backward (like a real coin toss)
		-- instead of spinning around its own axis like a drill
		coinPart.CFrame = CFrame.new(0, arc, 0)
			* CFrame.Angles(flipAngle, wobble, 0)
			* CFrame.Angles(0, 0, math.rad(90))
	end)

	-- Highlight winner coin circle after animation
	task.delay(ANIM_TIME + 0.3, function()
		if landsSide == "tung" then
			leftCoinBg:FindFirstChildOfClass("UIStroke").Color = P.Green
			leftCoinBg:FindFirstChildOfClass("UIStroke").Thickness = 5
		else
			rightCoinBg:FindFirstChildOfClass("UIStroke").Color = P.Green
			rightCoinBg:FindFirstChildOfClass("UIStroke").Thickness = 5
		end
	end)
end)

