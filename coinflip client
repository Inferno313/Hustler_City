ShowResult.OnClientEvent:Connect(function(tbl, iWon, betAmount)
	task.wait(0.5)
	resultPanel.Visible = true

	if iWon then
		resultTitle.Text        = "YOU WIN!"
		resultTitle.TextColor3  = P.Green
		resultAmount.Text       = "+" .. formatCash(betAmount)
		resultAmount.TextColor3 = P.Green
		resultImg.Image         = (mySide == "tung") and TUNG_TUNG_ID or TRALALELO_ID
		resultSideText.Text     = (mySide == "tung") and "Tung Tung Wins!" or "Tralalelo Wins!"
	else
		resultTitle.Text        = "YOU LOSE"
		resultTitle.TextColor3  = P.Red
		resultAmount.Text       = "-" .. formatCash(betAmount)
		resultAmount.TextColor3 = P.Red
		local loserSide = (mySide == "tung") and "trala" or "tung"
		resultImg.Image         = (loserSide == "tung") and TUNG_TUNG_ID or TRALALELO_ID
		resultSideText.Text     = (loserSide == "tung") and "Tung Tung Wins!" or "Tralalelo Wins!"
	end

	-- Pop-in animation
	resultPanel.Size = UDim2.new(0,10,0,10)
	TweenService:Create(resultPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back), {
		Size = UDim2.new(0,480,0,280),
	}):Play()
end)

