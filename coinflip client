local gui = Instance.new("ScreenGui")
gui.Name           = "CoinflipUI"
gui.ResetOnSpawn   = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent         = playerGui

local function new(class, props, children)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do i[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = i end
	return i
end

local function corner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 10); c.Parent = p end
local function stroke(p, t, col) local s = Instance.new("UIStroke"); s.Thickness = t or 2; s.Color = col or P.Gold; s.Parent = p end

local function btn(text, size, pos, bg, fg)
	local b = new("TextButton", {
		Text = text, Size = size or UDim2.new(0.4,0,0,50),
		Position = pos or UDim2.new(0.5,0,0.85,0), AnchorPoint = Vector2.new(0.5,0.5),
		BackgroundColor3 = bg or P.BtnGold, TextColor3 = fg or P.BtnDark,
		Font = Enum.Font.GothamBold, TextSize = 20, AutoButtonColor = true,
	})
	corner(b, 8)
	return b
end

local function formatCash(n)
	local s = tostring(math.floor(n))
	local k; while true do s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2"); if k == 0 then break end end
	return "$" .. s
end

