	-- Bottom trim all around
	part(model, {
		Name = "BottomTrimBack",
		Size = Vector3.new(W, 0.3, 0.6),
		CFrame = CFrame.new(cx, Y0 + 0.15, cz + D/2),
		Color = C.Gold, Material = Enum.Material.Metal,
