-- ============================================================================
-- MAIN MODULE FUNCTION
-- ============================================================================
function CasinoBuilderTiers.build(lotPart, casinoLevel, playerName)
	local level = math.clamp(casinoLevel or 1, 1, 4)
	if level == 1 then
		return buildSmall(lotPart, playerName)
	elseif level == 2 then
		return buildMedium(lotPart, playerName)
	elseif level == 3 then
		return buildLarge(lotPart, playerName)
	else
		return buildMega(lotPart, playerName)
	end
end
return CasinoBuilderTiers
