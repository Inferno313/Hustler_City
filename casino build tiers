-- ============================================================================
-- HELPER FUNCTIONS
-- ============================================================================
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = (props.CanCollide ~= nil) and props.CanCollide or true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = props.Name or "Part"
	p.Size = props.Size or Vector3.new(1,1,1)
	p.CFrame = props.CFrame or CFrame.new()
	p.Color = props.Color or Color3.new(0.5, 0.5, 0.5)
	p.Material = props.Material or Enum.Material.Concrete
	p.Transparency = props.Transparency or 0
	if props.Shape then p.Shape = props.Shape end
	p.Parent = parent
	return p
end
local function addPointLight(host, brightness, range, color)
	local l = Instance.new("PointLight")
	l.Brightness = brightness or 1
	l.Range = range or 20
	l.Color = color or Color3.fromRGB(255, 230, 190)
	l.Shadows = true
	l.Parent = host
end
--- Adds a SurfaceGui text label on the given face
local function addSign(host, face, text, textColor, bgColor)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(1024, 256)
	sg.AlwaysOnTop = false
	sg.LightInfluence = 0       -- sign text glows on its own
	sg.Brightness = 1
	sg.Parent = host
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1,0,1,0)
	lbl.BackgroundColor3 = bgColor or C.SignBg
	lbl.BackgroundTransparency = 0
	lbl.Text = text
	lbl.TextColor3 = textColor or C.GoldBright
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	lbl.Parent = sg
end

--- Build front wall with a wide open entrance in the center
--- NOW: uses Glass material + transparency for see-through walls
local function buildFrontWallWithOpening(model, centerX, Y0, W, H, wallZ, openW, openH, wallColor, wallMat)
	-- Override to glass
	wallMat = Enum.Material.Glass
	local glassTransparency = 0.5
	-- Left section of front wall
	local leftW = (W - openW) / 2
	if leftW > 0.5 then
		part(model, {
			Name = "FrontWallLeft",
			Size = Vector3.new(leftW, H, 0.5),
			CFrame = CFrame.new(centerX - openW/2 - leftW/2, Y0 + H/2, wallZ),
			Color = C.Glass, Material = wallMat,
			Transparency = glassTransparency,
		})
	end
	-- Right section of front wall
	local rightW = leftW
	if rightW > 0.5 then
		part(model, {
			Name = "FrontWallRight",
			Size = Vector3.new(rightW, H, 0.5),
			CFrame = CFrame.new(centerX + openW/2 + rightW/2, Y0 + H/2, wallZ),
			Color = C.Glass, Material = wallMat,
			Transparency = glassTransparency,
		})
	end
	-- Header above opening
	local headerH = H - openH
	if headerH > 0.5 then
		part(model, {
			Name = "FrontWallHeader",
			Size = Vector3.new(openW, headerH, 0.5),
			CFrame = CFrame.new(centerX, Y0 + openH + headerH/2, wallZ),
			Color = C.Glass, Material = wallMat,
			Transparency = glassTransparency,
		})
	end
end

-- ============================================================================
-- BRAINROT PEDESTAL HELPER (UPDATED — floor-level spots)
-- Creates simple floor-level pedestal spots inside a casino model.
-- Each pedestal = a flat glowing ring on the floor + invisible anchor above it
-- Inspired by "steal a brainrot" style display spots
-- ============================================================================
local function addBrainrotPedestals(model, cx, Y0, cz, W, D, count)
	local positions = {}

	if count <= 4 then
		-- Place along left wall
		local wallX = cx - W/2 + 3
		local startZ = cz - D/2 + 5
		local endZ   = cz + D/2 - 8  -- stay away from bar area at back
		local spacing = (endZ - startZ) / math.max(count - 1, 1)
		for i = 1, count do
			table.insert(positions, {
				x = wallX,
				z = startZ + (i - 1) * spacing,
			})
		end
	elseif count <= 6 then
		-- 3 along left wall, rest along right wall
		local leftX  = cx - W/2 + 3
		local rightX = cx + W/2 - 3
		local startZ = cz - D/2 + 5
		local endZ   = cz + D/2 - 8
		local leftCount = 3
		local leftSpacing = (endZ - startZ) / math.max(leftCount - 1, 1)
		for i = 1, leftCount do
			table.insert(positions, {
				x = leftX,
				z = startZ + (i - 1) * leftSpacing,
			})
		end
		local rightCount = count - leftCount
		local rightSpacing = (endZ - startZ) / math.max(rightCount - 1, 1)
		for i = 1, rightCount do
			table.insert(positions, {
				x = rightX,
				z = startZ + (i - 1) * rightSpacing,
			})
		end
	else
		-- 5 along left wall, 5 along right wall
		local leftX  = cx - W/2 + 3
		local rightX = cx + W/2 - 3
		local startZ = cz - D/2 + 5
		local endZ   = cz + D/2 - 8
		local perSide = math.ceil(count / 2)
		local leftSpacing = (endZ - startZ) / math.max(perSide - 1, 1)
		for i = 1, perSide do
			table.insert(positions, {
				x = leftX,
				z = startZ + (i - 1) * leftSpacing,
			})
		end
		local rightCount = count - perSide
		local rightSpacing = (endZ - startZ) / math.max(rightCount - 1, 1)
		for i = 1, rightCount do
			table.insert(positions, {
				x = rightX,
				z = startZ + (i - 1) * rightSpacing,
			})
		end
	end

	-- Create clean solid pedestal platforms (no glow, no neon)
	for i, pos in ipairs(positions) do
		-- Solid platform
		part(model, {
			Name = "PedestalBase_" .. i,
			Size = Vector3.new(4, 0.5, 4),
			CFrame = CFrame.new(pos.x, Y0 + 0.25, pos.z),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.SmoothPlastic,
		})
		-- Lighter top surface
		part(model, {
			Name = "PedestalTop_" .. i,
			Size = Vector3.new(3.8, 0.08, 3.8),
			CFrame = CFrame.new(pos.x, Y0 + 0.51, pos.z),
			Color = Color3.fromRGB(90, 90, 100),
			Material = Enum.Material.SmoothPlastic,
		})
		-- Invisible anchor just above surface (BrainrotService uses this)
		local anchor = part(model, {
			Name = "BrainrotPedestal_" .. i,
			Size = Vector3.new(2, 0.1, 2),
			CFrame = CFrame.new(pos.x, Y0 + 0.6, pos.z),
			Color = Color3.new(1, 1, 1),
			Transparency = 1,
			CanCollide = false,
		})
		anchor.CanCollide = false
	end

	-- Store casino center coordinates as attributes for BrainrotService tile positioning
	model:SetAttribute("CasinoCenterX", cx)
	model:SetAttribute("CasinoCenterZ", cz)
end

