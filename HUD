-- ============================================================
-- OVERHEAD TAG — brainrot style (big green text, no background)
-- ============================================================
local currentTitle = "Broke Bum"
local currentLevel = 1

local function setupOverheadTag(character, title, lvl)
	-- Remove old tag
	local old = character:FindFirstChild("HustleTag")
	if old then old:Destroy() end

	local head = character:WaitForChild("Head", 5)
	if not head then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HustleTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 220, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 2.2, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 60
	billboard.ResetOnSpawn = false
	billboard.Parent = character

	-- Player name — big, white, with black stroke (exactly like brainrot games)
	local nameText = Instance.new("TextLabel", billboard)
	nameText.Size = UDim2.new(1, 0, 0.54, 0)
	nameText.Position = UDim2.new(0, 0, 0, 0)
	nameText.BackgroundTransparency = 1
	nameText.Text = player.Name
	nameText.Font = Enum.Font.GothamBold
	nameText.TextSize = 20
	nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameText.TextStrokeTransparency = 0    -- solid black outline
	nameText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameText.TextScaled = false

	-- Title — bright green with black stroke, just like steal a brainrot
	local titleText = Instance.new("TextLabel", billboard)
	titleText.Name = "TitleText"
	titleText.Size = UDim2.new(1, 0, 0.44, 0)
	titleText.Position = UDim2.new(0, 0, 0.54, 0)
	titleText.BackgroundTransparency = 1
	titleText.Text = "⭐ " .. title
	titleText.Font = Enum.Font.GothamBold
	titleText.TextSize = 16
	titleText.TextColor3 = Color3.fromRGB(0, 255, 100)  -- that iconic bright green
	titleText.TextStrokeTransparency = 0
	titleText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	titleText.TextScaled = false
end

-- ============================================================
-- UPDATE JUST THE TITLE TEXT (no need to rebuild whole tag)
-- ============================================================
local function updateOverheadTitle(character, title)
	local billboard = character:FindFirstChild("HustleTag")
	if not billboard then return end
	local titleText = billboard:FindFirstChild("TitleText")
	if titleText then
		titleText.Text = "⭐ " .. title
	end
end

-- ============================================================
-- REFRESH HUD
-- ============================================================
local function refreshHUD()
	local ok, stats = pcall(function()
		return GetHUDStats:InvokeServer()
	end)
	if not ok or not stats then return end

	local newText = formatCash(stats.Cash)
	if cashAmount.Text ~= newText then
		showCashChange(stats.Cash - lastCash)
		lastCash = stats.Cash
		cashAmount.Text = newText
	end

	levelLabel.Text = "Level " .. stats.Level .. "  ·  " .. stats.Title

	local lo = stats.CurrentLevelMin or 0
	local hi = stats.NextLevelMin or 0
	local pct = hi > lo and math.clamp((stats.NetWorth - lo) / (hi - lo), 0, 1) or 1
	TweenService:Create(progressFill,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad),
		{ Size = UDim2.new(pct, 0, 1, 0) }
	):Play()

	if stats.Title ~= currentTitle or stats.Level ~= currentLevel then
		currentTitle = stats.Title
		currentLevel = stats.Level
		local char = player.Character
		if char then updateOverheadTitle(char, currentTitle) end
	end
end

-- ============================================================
-- CHARACTER SPAWN
-- ============================================================
local function onCharacterAdded(character)
	task.wait(0.5)
	setupOverheadTag(character, currentTitle, currentLevel)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	task.spawn(function()
		onCharacterAdded(player.Character)
	end)
end

-- ============================================================
-- LEVEL UP EVENT
-- ============================================================
LevelUp.OnClientEvent:Connect(function(newLevel, newTitle)
	currentLevel = newLevel
	currentTitle = newTitle
	levelLabel.Text = "Level " .. newLevel .. "  ·  " .. newTitle
	showLevelUpBanner(newTitle)
	local char = player.Character
	if char then updateOverheadTitle(char, newTitle) end
	refreshHUD()
end)

-- ============================================================
-- POLL LOOP
-- ============================================================
refreshHUD()
task.spawn(function()
	while task.wait(2.5) do refreshHUD() end
end)
