-- ============================================================
-- CASH CHANGE POPUP
-- ============================================================
local lastCash = 100

local function showCashChange(amount)
	if amount == 0 then return end
	local popup = Instance.new("TextLabel", gui)
	popup.Size = UDim2.new(0, 140, 0, 24)
	popup.Position = UDim2.new(0, 16, 1, -118)
	popup.BackgroundTransparency = 1
	popup.Text = (amount > 0 and "+" or "") .. formatCash(amount)
	popup.Font = Enum.Font.GothamBold
	popup.TextSize = 16
	popup.TextColor3 = amount > 0 and Color3.fromRGB(60, 220, 110) or Color3.fromRGB(255, 80, 80)
	popup.TextXAlignment = Enum.TextXAlignment.Left
	popup.ZIndex = 20
	TweenService:Create(popup,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0, 16, 1, -160), TextTransparency = 1 }
	):Play()
	task.delay(1.5, function() popup:Destroy() end)
end

