local function renderHandInstant(frame, hand, hideSecond)
	clearFrame(frame)
	for i,c in ipairs(hand) do
		local hidden = hideSecond and i==2
		local cu = makeCard(c.rank, c.suit, hidden)
		cu.Position = UDim2.new(0,(i-1)*74,0,0); cu.Parent=frame
	end
end

local function renderHandAnimated(frame, hand, hideSecond, stagger)
	clearFrame(frame)
	stagger = stagger or 0.4
	for i,c in ipairs(hand) do
		local hidden = hideSecond and i==2
		local cu = makeCard(c.rank, c.suit, hidden)
		cu.Position = UDim2.new(0,(i-1)*74,0,0); cu.Parent=frame
		task.delay((i-1)*stagger, function() animateCardIn(cu) end)
	end
end

-- Dealer reveal: flip hidden card, then draw new cards one by one
-- Returns total animation time
local function revealDealerSequence(hand)
	clearFrame(dealerCards)
	local CARD_DELAY = 0.6
	local totalTime = 0

	-- Card 1: face-up instantly
	local c1 = makeCard(hand[1].rank, hand[1].suit, false)
	c1.Position = UDim2.new(0,0,0,0); c1.Parent=dealerCards

	-- Card 2: flip from hidden to revealed
	local c2 = makeCard(hand[2].rank, hand[2].suit, false)
	c2.Position = UDim2.new(0,74,0,0); c2.Parent=dealerCards
	animateCardIn(c2)
	totalTime = 0.5

	-- Update total after flip for 2-card hands
	if #hand == 2 then
		task.delay(0.35, function()
			local t,a=0,0
			for _,cd in ipairs(hand) do t+=cd.value; if cd.rank=="A" then a+=1 end end
			while t>21 and a>0 do t-=10;a-=1 end
			dtLbl.Text = tostring(t)
		end)
	end

	-- Cards 3+ draw one at a time with CARD_DELAY between each
	for i=3, #hand do
		local delay = totalTime + (i-3)*CARD_DELAY
		local cardIdx = i
		task.delay(delay, function()
			local cu = makeCard(hand[cardIdx].rank, hand[cardIdx].suit, false)
			cu.Position = UDim2.new(0,(cardIdx-1)*74,0,0); cu.Parent=dealerCards
			animateCardIn(cu)
			-- Update running total after each card lands
			task.delay(0.25, function()
				local t,aces=0,0
				for j=1,cardIdx do
					t+=hand[j].value; if hand[j].rank=="A" then aces+=1 end
				end
				while t>21 and aces>0 do t-=10;aces-=1 end
				dtLbl.Text = tostring(t)
			end)
		end)
		totalTime = delay + 0.4
	end

	totalTime = totalTime + 0.3
	return totalTime
end

local function renderAllHands(hands, activeHand, phase, animate)
	clearFrame(handsCont)
	local n=#hands; local hw=math.min(360,math.floor(700/n))
	for i,h in ipairs(hands) do
		local hf=Instance.new("Frame")
		hf.Size=UDim2.new(0,hw,0,165); hf.Position=UDim2.new(0,(i-1)*hw,0,0)
		hf.BackgroundTransparency=1; hf.ZIndex=3; hf.Parent=handsCont

		if n>1 then
			local ind=Instance.new("Frame"); ind.Size=UDim2.new(1,-6,1,-6); ind.Position=UDim2.new(0,3,0,3)
			ind.BackgroundTransparency=1; ind.ZIndex=3; ind.Parent=hf
			Instance.new("UICorner",ind).CornerRadius=UDim.new(0,8)
			local is=Instance.new("UIStroke",ind); is.Thickness=1; is.Transparency=0.5
			if i==activeHand and phase=="playing" then is.Color=T.accent;is.Thickness=2;is.Transparency=0.2
			elseif h.result=="win" or h.result=="blackjack" then is.Color=T.winGreen
			elseif h.result=="lose" or h.result=="bust" then is.Color=T.losePink
			elseif h.result=="push" then is.Color=T.pushYel
			else is.Color=T.border end
		end

		local nl=Instance.new("TextLabel"); nl.Size=UDim2.new(0,80,0,16); nl.Position=UDim2.new(0,8,0,4)
		nl.BackgroundTransparency=1; nl.Text=n>1 and ("Hand "..i) or "You"
		nl.TextColor3=i==activeHand and phase=="playing" and T.accent or T.textDim
		nl.TextSize=11; nl.Font=Enum.Font.GothamBold; nl.TextXAlignment=Enum.TextXAlignment.Left
		nl.ZIndex=4; nl.Parent=hf

		local tb=Instance.new("Frame"); tb.Size=UDim2.new(0,32,0,18); tb.Position=UDim2.new(0,90,0,3)
		tb.BackgroundColor3=T.card; tb.BorderSizePixel=0; tb.ZIndex=4; tb.Parent=hf
		Instance.new("UICorner",tb).CornerRadius=UDim.new(0,5)
		local tl=Instance.new("TextLabel"); tl.Size=UDim2.new(1,0,1,0); tl.BackgroundTransparency=1
		tl.Text=tostring(h.total or 0); tl.TextColor3=T.textMain; tl.TextSize=12
		tl.Font=Enum.Font.GothamBold; tl.ZIndex=5; tl.Parent=tb

		if h.message and h.message~="" then
			local rl=Instance.new("TextLabel"); rl.Size=UDim2.new(1,-8,0,14); rl.Position=UDim2.new(0,8,0,22)
			rl.BackgroundTransparency=1; rl.Text=h.message; rl.TextSize=11; rl.Font=Enum.Font.GothamBold
			rl.TextXAlignment=Enum.TextXAlignment.Left; rl.ZIndex=4; rl.Parent=hf
			if h.result=="win" or h.result=="blackjack" then rl.TextColor3=T.winGreen
			elseif h.result=="lose" or h.result=="bust" then rl.TextColor3=T.losePink
			else rl.TextColor3=T.pushYel end
		end

		local cf=Instance.new("Frame"); cf.Size=UDim2.new(1,-16,0,100); cf.Position=UDim2.new(0,8,0,40)
		cf.BackgroundTransparency=1; cf.ZIndex=3; cf.Parent=hf
		for j,card in ipairs(h.cards) do
			local cu=makeCard(card.rank,card.suit,false)
			cu.Position=UDim2.new(0,(j-1)*72,0,0); cu.Parent=cf
			if animate then task.delay((j-1)*0.35, function() animateCardIn(cu) end) end
		end

		if n>1 then
			local bl=Instance.new("TextLabel"); bl.Size=UDim2.new(1,-8,0,14); bl.Position=UDim2.new(0,8,1,-18)
			bl.BackgroundTransparency=1; bl.Text="$"..h.bet; bl.TextColor3=T.textMuted; bl.TextSize=10
			bl.Font=Enum.Font.Gotham; bl.TextXAlignment=Enum.TextXAlignment.Left; bl.ZIndex=4; bl.Parent=hf
		end
	end
end

-- ══════════════════════════════════════════
-- PHASE CONTROL
-- ══════════════════════════════════════════
local function hideAll()
	chipFrame.Visible=false
	for _,b in ipairs({clearBtn,dealBtn,hitBtn,standBtn,doubleBtn,splitBtn,replayBtn,insYesBtn,insNoBtn}) do b.Visible=false end
end

local function enterBetting()
	currentBet=0; betLbl.Text="$0"; msgLbl.Text="Place your bet"; msgLbl.TextColor3=T.textDim
	clearFrame(dealerCards); clearFrame(handsCont); dtLbl.Text=""
	hideAll(); chipFrame.Visible=true; clearBtn.Visible=true; dealBtn.Visible=true
	posCenter({clearBtn, dealBtn})
end

local function flashMsg(text,color)
	msgLbl.TextColor3=color or T.accent; msgLbl.Text=text; msgLbl.TextTransparency=1
	TweenService:Create(msgLbl,TweenInfo.new(0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{TextTransparency=0}):Play()
end

local isFirstState = true

BJUpdate.OnClientEvent:Connect(function(state)
	if state.phase=="betting" then
		if state.message and state.message~="" then flashMsg(state.message,T.red)
		else enterBetting() end
		isFirstState=true; return
	end

	local animate = isFirstState
	isFirstState = false

	betLbl.Text = "$"..string.format("%g",state.totalBet or 0)
	hideAll()

	-- ── PLAYING / INSURANCE PHASE ──
	if state.phase=="playing" or state.phase=="insurance" then
		if state.dealerHand then
			if animate then
				renderHandAnimated(dealerCards, state.dealerHand, true, 0.4)
			else
				renderHandInstant(dealerCards, state.dealerHand, true)
			end
			dtLbl.Text = "?"
		end
		if state.hands then
			renderAllHands(state.hands, state.activeHand, state.phase, animate)
		end

		if state.phase=="playing" then
			-- Delay showing action buttons until initial deal animation finishes
			if animate then
				local dealTime = 0.4 * 2 + 0.35 * 2 + 0.3 -- dealer cards + player cards + buffer
				task.delay(dealTime, function()
					hitBtn.Visible=true; standBtn.Visible=true
					doubleBtn.Visible=state.canDouble or false; splitBtn.Visible=state.canSplit or false
					local btns={hitBtn,standBtn}
					if state.canDouble then table.insert(btns,doubleBtn) end
					if state.canSplit then table.insert(btns,splitBtn) end
					posCenter(btns)
				end)
			else
				hitBtn.Visible=true; standBtn.Visible=true
				doubleBtn.Visible=state.canDouble or false; splitBtn.Visible=state.canSplit or false
				local btns={hitBtn,standBtn}
				if state.canDouble then table.insert(btns,doubleBtn) end
				if state.canSplit then table.insert(btns,splitBtn) end
				posCenter(btns)
			end
		elseif state.phase=="insurance" then
			local cost=state.insuranceCost or 0
			insYesBtn.Text="Insurance ($"..cost..")"
			local dealTime = animate and (0.4*2+0.35*2+0.3) or 0
			task.delay(dealTime, function()
				insYesBtn.Visible=true; insNoBtn.Visible=true
				posCenter({insYesBtn,insNoBtn})
				flashMsg("Dealer shows Ace — Insurance?",T.orange)
			end)
		end

		if state.message and state.message~="" and state.phase=="playing" and not animate then
			flashMsg(state.message, T.accent)
		end
		return
	end

	-- ── DONE PHASE — DEALER REVEAL SEQUENCE ──
	if state.phase=="done" then
		if state.hands then
			renderAllHands(state.hands, state.activeHand, "done", false)
		end

		-- Dealer reveal animation (slow, one card at a time)
		local revealTime = 0
		if state.dealerHand then
			revealTime = revealDealerSequence(state.dealerHand)
		end

		-- Show result message AFTER dealer finishes drawing
		if state.message and state.message~="" then
			task.delay(revealTime, function()
				local col=T.accent
				if state.result=="win" or state.result=="blackjack" then col=T.winGreen
				elseif state.result=="lose" or state.result=="bust" then col=T.losePink
				elseif state.result=="push" then col=T.pushYel end
				flashMsg(state.message, col)
				if state.result=="win" or state.result=="blackjack" then sndWin:Play() end
			end)
		end

		-- Show "Bet Again" AFTER result
		task.delay(revealTime + 0.5, function()
			replayBtn.Visible=true; posCenter({replayBtn})
		end)

		-- Final dealer total AFTER all cards
		task.delay(revealTime, function()
			dtLbl.Text = tostring(state.dealerTotal or "")
		end)
	end
end)

