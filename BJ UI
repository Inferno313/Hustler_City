local function clearFrame(f) for _,c in ipairs(f:GetChildren()) do c:Destroy() end end

local function makeCard(rank, suit, hidden)
	local wrap=Instance.new("Frame")
	wrap.Size=UDim2.new(0,68,0,95); wrap.BackgroundTransparency=1; wrap.ZIndex=4

	local c=Instance.new("Frame")
	c.Size=UDim2.new(1,0,1,0); c.BorderSizePixel=0; c.ZIndex=4; c.Parent=wrap
	Instance.new("UICorner",c).CornerRadius=UDim.new(0,10)

	if hidden then
		c.BackgroundColor3=T.cardBack
		local inner=Instance.new("Frame")
		inner.Size=UDim2.new(0.7,0,0.7,0); inner.Position=UDim2.new(0.15,0,0.15,0)
		inner.BackgroundColor3=T.accent; inner.BackgroundTransparency=0.85
		inner.BorderSizePixel=0; inner.ZIndex=5; inner.Parent=c
		Instance.new("UICorner",inner).CornerRadius=UDim.new(0,8)
		local is=Instance.new("UIStroke",inner); is.Color=T.accent; is.Thickness=1.5; is.Transparency=0.5
		local q=Instance.new("TextLabel"); q.Size=UDim2.new(1,0,1,0); q.BackgroundTransparency=1
		q.Text="?"; q.TextColor3=T.accent; q.TextSize=32; q.Font=Enum.Font.GothamBold
		q.ZIndex=6; q.TextTransparency=0.6; q.Parent=inner
		local cs=Instance.new("UIStroke",c); cs.Color=T.accent; cs.Transparency=0.4
	else
		c.BackgroundColor3=T.cardFace
		local sym=SUIT_SYM[suit] or "?"; local col=SUIT_COL[suit] or T.black
		local isRed=suit=="heart" or suit=="diamond"
		local tc=isRed and T.red or Color3.fromRGB(30,30,30)

		local tr=Instance.new("TextLabel"); tr.Size=UDim2.new(0,28,0,20); tr.Position=UDim2.new(0,5,0,4)
		tr.BackgroundTransparency=1; tr.Text=rank; tr.TextColor3=tc; tr.TextSize=15
		tr.Font=Enum.Font.GothamBold; tr.TextXAlignment=Enum.TextXAlignment.Left; tr.ZIndex=5; tr.Parent=c

		local ts=Instance.new("TextLabel"); ts.Size=UDim2.new(0,20,0,14); ts.Position=UDim2.new(0,5,0,22)
		ts.BackgroundTransparency=1; ts.Text=sym; ts.TextColor3=col; ts.TextSize=12
		ts.Font=Enum.Font.GothamBold; ts.TextXAlignment=Enum.TextXAlignment.Left; ts.ZIndex=5; ts.Parent=c

		local cs2=Instance.new("TextLabel"); cs2.Size=UDim2.new(0,40,0,40); cs2.Position=UDim2.new(0.5,-20,0.5,-20)
		cs2.BackgroundTransparency=1; cs2.Text=sym; cs2.TextColor3=col; cs2.TextSize=34
		cs2.Font=Enum.Font.GothamBold; cs2.ZIndex=5; cs2.Parent=c

		local br=Instance.new("TextLabel"); br.Size=UDim2.new(0,28,0,20); br.Position=UDim2.new(1,-33,1,-24)
		br.BackgroundTransparency=1; br.Text=rank; br.TextColor3=tc; br.TextSize=15
		br.Font=Enum.Font.GothamBold; br.TextXAlignment=Enum.TextXAlignment.Right; br.ZIndex=5; br.Parent=c

		local bs=Instance.new("TextLabel"); bs.Size=UDim2.new(0,20,0,14); bs.Position=UDim2.new(1,-25,1,-38)
		bs.BackgroundTransparency=1; bs.Text=sym; bs.TextColor3=col; bs.TextSize=12
		bs.Font=Enum.Font.GothamBold; bs.TextXAlignment=Enum.TextXAlignment.Right; bs.ZIndex=5; bs.Parent=c

		local stroke=Instance.new("UIStroke",c); stroke.Color=Color3.fromRGB(200,200,200); stroke.Transparency=0.6
	end
	return wrap
end

-- Animate a card sliding in from above
local function animateCardIn(cardUI)
	local inner = cardUI:FindFirstChildWhichIsA("Frame")
	if not inner then return end
	inner.BackgroundTransparency = 1
	for _,d in ipairs(inner:GetDescendants()) do
		if d:IsA("TextLabel") then d.TextTransparency=1 end
		if d:IsA("Frame") then d.BackgroundTransparency=1 end
		if d:IsA("UIStroke") then d.Transparency=1 end
	end
	local origPos = cardUI.Position
	cardUI.Position = origPos + UDim2.new(0,0,0,-20)

	sndDeal:Play()
	TweenService:Create(cardUI, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = origPos
	}):Play()
	TweenService:Create(inner, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency=0}):Play()
	task.delay(0.08, function()
		for _,d in ipairs(inner:GetDescendants()) do
			if d:IsA("TextLabel") then
				local tgt = 0
				if d.Text=="?" then tgt=0.6 end
				TweenService:Create(d, TweenInfo.new(0.15), {TextTransparency=tgt}):Play()
			end
			if d:IsA("Frame") then
				local tgt2 = 0
				if d:FindFirstChild("UIStroke") then tgt2=0.85 end
				TweenService:Create(d, TweenInfo.new(0.15), {BackgroundTransparency=tgt2}):Play()
			end
			if d:IsA("UIStroke") then
				TweenService:Create(d, TweenInfo.new(0.15), {Transparency=0.4}):Play()
			end
		end
	end)
end

