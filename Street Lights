-- ============================================================
--  HUSTLE CITY: Casino Empire
--  Script: LightController
--  Place this Script INSIDE the Streetlight model.
--
--  Expected model structure:
--
--    Model "Streetlight"
--    ├─ Part "Pole"
--    ├─ Part "Arm"
--    └─ Part "LampHead"          ← PrimaryPart
--       ├─ PointLight  "Glow"
--       └─ SurfaceLight "SurfaceGlow"
--    └─ Script "LightController" ← this script
--
--  To add more streetlights: just duplicate the model in the
--  Explorer and drag the copy wherever you want. No other setup needed.
-- ============================================================

local Lighting     = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

-- ── Config ────────────────────────────────────────────────────
local LIGHT_COLOR      = Color3.fromRGB(255, 200, 100)   -- warm sodium yellow
local LIGHT_BRIGHTNESS = 2.5
local LIGHT_RANGE      = 30

local LIGHTS_ON_TIME   = 18    -- 6 pm  (Lighting.ClockTime, 0–24)
local LIGHTS_OFF_TIME  = 7     -- 7 am
local FADE_TIME        = 3     -- seconds to fade on / off

local ALWAYS_ON        = false -- true = lights on 24 / 7 (handy for testing)
-- ─────────────────────────────────────────────────────────────

local model = script.Parent
local lamp  = model:FindFirstChild("LampHead", true)

if not lamp then
	warn("[StreetLight] LampHead part not found in", model:GetFullName())
	return
end

local pointLight   = lamp:FindFirstChildWhichIsA("PointLight")
local surfaceLight = lamp:FindFirstChildWhichIsA("SurfaceLight")

if not pointLight or not surfaceLight then
	warn("[StreetLight] Missing PointLight or SurfaceLight inside LampHead of", model:GetFullName())
	return
end

-- ── Helpers ───────────────────────────────────────────────────

local function lightsOnNow()
	if ALWAYS_ON then return true end
	local t = Lighting.ClockTime
	if LIGHTS_ON_TIME > LIGHTS_OFF_TIME then
		-- spans midnight (e.g. on=18, off=7)
		return t >= LIGHTS_ON_TIME or t < LIGHTS_OFF_TIME
	else
		return t >= LIGHTS_ON_TIME and t < LIGHTS_OFF_TIME
	end
end

local function setLights(on)
	local brightness = on and LIGHT_BRIGHTNESS or 0
	local lampColor  = on and LIGHT_COLOR or Color3.fromRGB(150, 150, 140)
	local info       = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad)

	TweenService:Create(pointLight,   info, { Brightness = brightness }):Play()
	TweenService:Create(surfaceLight, info, { Brightness = brightness }):Play()
	TweenService:Create(lamp,         info, { Color = lampColor }):Play()
end

-- ── Main loop ─────────────────────────────────────────────────

local currentlyOn = lightsOnNow()
setLights(currentlyOn)

while task.wait(5) do
	local shouldBeOn = lightsOnNow()
	if shouldBeOn ~= currentlyOn then
		currentlyOn = shouldBeOn
		setLights(currentlyOn)
	end
end
