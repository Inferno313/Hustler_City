-- ============================================================
--  HUSTLE CITY: Casino Empire
--  Script: Street Lights (Script in ServerScriptService)
--  Spawns streetlight models along road parts in the city,
--  attaches warm PointLights, and runs a day/night cycle.
-- ============================================================

local Lighting     = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

-- ============================================================
-- CONFIG
-- ============================================================

local CONFIG = {
	-- ── Placement ───────────────────────────────────────────
	-- Studs between each streetlight along a road
	SPACING = 20,

	-- Studs off the road centre-line (kerb offset)
	SIDE_OFFSET = 8,

	-- Place lights on both sides of every road segment?
	BOTH_SIDES = true,

	-- ── Pole / Lamp Dimensions ──────────────────────────────
	POLE_HEIGHT    = 12,
	POLE_THICKNESS = 0.4,
	ARM_LENGTH     = 2.5,
	LAMP_SIZE      = Vector3.new(1.2, 0.5, 1.2),

	-- ── Light Properties ────────────────────────────────────
	-- Warm sodium-vapour yellow
	LIGHT_COLOR      = Color3.fromRGB(255, 200, 100),
	LIGHT_BRIGHTNESS = 2.5,
	LIGHT_RANGE      = 30,

	-- ── Day / Night ─────────────────────────────────────────
	LIGHTS_ON_TIME  = 18,   -- 6 pm  (Lighting.ClockTime)
	LIGHTS_OFF_TIME = 7,    -- 7 am
	FADE_TIME       = 3,    -- seconds to fade on/off
	ALWAYS_ON       = false, -- set true to skip day/night during testing

	-- ── Road Detection – Strategy 1: Name Patterns ──────────
	-- Parts whose name contains ANY of these strings (case-insensitive)
	-- are treated as roads.
	ROAD_NAME_PATTERNS = {
		"road", "street", "avenue", "blvd", "lane", "path",
		"sidewalk", "pavement", "asphalt", "tarmac", "highway",
	},

	-- ── Road Detection – Strategy 2: CollectionService Tag ──
	-- Parts tagged with this tag in the Tag Editor are treated as roads.
	ROAD_TAG = "Road",

	-- ── Road Detection – Strategy 3: Shape Heuristic ────────
	-- A part is treated as a road if it passes ALL these checks:
	--   • is a BasePart (not Terrain)
	--   • height (Y size) ≤ ROAD_MAX_HEIGHT
	--   • longest horizontal dimension ≥ ROAD_MIN_LENGTH
	--   • is NOT excluded by SHAPE_EXCLUDE_NAMES
	SHAPE_DETECT         = true,   -- set false to disable shape heuristic
	ROAD_MAX_HEIGHT      = 1.5,    -- studs; road slabs are typically 0.2–1
	ROAD_MIN_LENGTH      = 20,     -- studs; road segment must be at least this long
	ROAD_MIN_WIDTH       = 8,      -- studs; road segment must be at least this wide
	SHAPE_EXCLUDE_NAMES  = {       -- never treat these as roads even if they match
		"baseplate", "ground", "floor", "terrain",
		"wall", "ceiling", "roof", "stair", "step",
		"lot", "plot", "casino", "building",
	},

	-- ── Output Folder ───────────────────────────────────────
	LIGHTS_FOLDER_NAME = "StreetLights",

	-- ── Debug ───────────────────────────────────────────────
	-- When true, prints every workspace BasePart that was considered
	-- but did not match so you can figure out the correct names.
	DEBUG_MODE = false,
}

-- ============================================================
-- ROAD DETECTION
-- ============================================================

local function nameContains(name, patterns)
	local lower = name:lower()
	for _, p in ipairs(patterns) do
		if lower:find(p, 1, true) then return true end
	end
	return false
end

local function isExcluded(name)
	return nameContains(name, CONFIG.SHAPE_EXCLUDE_NAMES)
end

-- Returns true if the part looks like a road by its physical shape
local function isRoadByShape(part)
	if not CONFIG.SHAPE_DETECT then return false end
	if not part:IsA("BasePart")  then return false end
	if isExcluded(part.Name)     then return false end

	local s = part.Size
	local minH = math.min(s.X, s.Y, s.Z)
	local maxH = math.max(s.X, s.Y, s.Z)
	local midH = s.X + s.Y + s.Z - minH - maxH  -- middle dimension

	-- Y (vertical) must be small → it's a flat slab
	if s.Y > CONFIG.ROAD_MAX_HEIGHT then return false end
	-- longest horizontal span must be road-sized
	if math.max(s.X, s.Z) < CONFIG.ROAD_MIN_LENGTH then return false end
	-- width (short horizontal span) must be at least road-width
	if math.min(s.X, s.Z) < CONFIG.ROAD_MIN_WIDTH  then return false end

	return true
end

-- Returns true if the part matches by name pattern
local function isRoadByName(part)
	if not part:IsA("BasePart") then return false end
	return nameContains(part.Name, CONFIG.ROAD_NAME_PATTERNS)
end

-- Returns true if the part is tagged as a road
local function isRoadByTag(part)
	return CollectionService:HasTag(part, CONFIG.ROAD_TAG)
end

-- Scan the entire workspace and collect road parts using all three strategies
local function collectRoadParts()
	local seen  = {}   -- deduplicate
	local roads = {}

	local byName  = 0
	local byTag   = 0
	local byShape = 0
	local skipped = {}

	local function consider(part)
		if seen[part] then return end
		if not part:IsA("BasePart") then return end
		seen[part] = true

		if isRoadByName(part) then
			table.insert(roads, part)
			byName += 1
		elseif isRoadByTag(part) then
			table.insert(roads, part)
			byTag += 1
		elseif isRoadByShape(part) then
			table.insert(roads, part)
			byShape += 1
		elseif CONFIG.DEBUG_MODE then
			table.insert(skipped, string.format(
				"  SKIP  %-40s  size=(%.0f, %.1f, %.0f)",
				part:GetFullName(), part.Size.X, part.Size.Y, part.Size.Z
			))
		end
	end

	local function scan(obj)
		consider(obj)
		for _, child in ipairs(obj:GetChildren()) do
			scan(child)
		end
	end
	scan(workspace)

	if CONFIG.DEBUG_MODE and #skipped > 0 then
		print("[StreetLights] DEBUG – non-road BaseParts:")
		for _, s in ipairs(skipped) do print(s) end
	end

	print(string.format(
		"[StreetLights] Found %d road part(s)  (by name: %d | by tag: %d | by shape: %d)",
		#roads, byName, byTag, byShape
	))
	return roads
end

-- ============================================================
-- POLE POSITION CALCULATOR
-- ============================================================

local function polePositionsForRoad(roadPart)
	local positions = {}
	local size = roadPart.Size
	local cf   = roadPart.CFrame

	-- The "length" axis is whichever horizontal span is larger
	local alongLocal, perpLocal
	if size.X >= size.Z then
		alongLocal = Vector3.new(1, 0, 0)
		perpLocal  = Vector3.new(0, 0, 1)
	else
		alongLocal = Vector3.new(0, 0, 1)
		perpLocal  = Vector3.new(1, 0, 0)
	end

	local halfLen  = math.max(size.X, size.Z) / 2
	local steps    = math.max(1, math.floor((halfLen * 2) / CONFIG.SPACING))
	local surfaceY = cf.Position.Y + size.Y / 2

	local sides = { CONFIG.SIDE_OFFSET }
	if CONFIG.BOTH_SIDES then sides = { CONFIG.SIDE_OFFSET, -CONFIG.SIDE_OFFSET } end

	for i = 0, steps - 1 do
		local t = -halfLen + (i + 0.5) * CONFIG.SPACING
		for _, sideSign in ipairs(sides) do
			local localOffset = alongLocal * t + perpLocal * sideSign
			local worldPos    = cf:PointToWorldSpace(localOffset)
			worldPos = Vector3.new(worldPos.X, surfaceY, worldPos.Z)
			local worldForward = cf:VectorToWorldSpace(perpLocal * sideSign).Unit
			table.insert(positions, { pos = worldPos, forward = worldForward })
		end
	end
	return positions
end

-- ============================================================
-- BUILD A SINGLE STREETLIGHT
-- ============================================================

local function buildStreetlight(parent, pos, forwardDir)
	local model = Instance.new("Model")
	model.Name  = "Streetlight"

	-- Pole
	local pole = Instance.new("Part")
	pole.Name       = "Pole"
	pole.Anchored   = true
	pole.CanCollide = false
	pole.Size       = Vector3.new(CONFIG.POLE_THICKNESS, CONFIG.POLE_HEIGHT, CONFIG.POLE_THICKNESS)
	pole.CFrame     = CFrame.new(pos + Vector3.new(0, CONFIG.POLE_HEIGHT / 2, 0))
	pole.Material   = Enum.Material.Metal
	pole.Color      = Color3.fromRGB(60, 60, 65)
	pole.Parent     = model

	-- Arm bracket
	local arm = Instance.new("Part")
	arm.Name       = "Arm"
	arm.Anchored   = true
	arm.CanCollide = false
	arm.Size       = Vector3.new(CONFIG.ARM_LENGTH, CONFIG.POLE_THICKNESS, CONFIG.POLE_THICKNESS)
	arm.CFrame     = CFrame.new(pos + Vector3.new(0, CONFIG.POLE_HEIGHT, 0) + forwardDir * (CONFIG.ARM_LENGTH / 2))
	arm.Material   = Enum.Material.Metal
	arm.Color      = Color3.fromRGB(60, 60, 65)
	arm.Parent     = model

	-- Lamp head
	local lamp = Instance.new("Part")
	lamp.Name       = "LampHead"
	lamp.Anchored   = true
	lamp.CanCollide = false
	lamp.Size       = CONFIG.LAMP_SIZE
	lamp.CFrame     = CFrame.new(pos + Vector3.new(0, CONFIG.POLE_HEIGHT - 0.25, 0) + forwardDir * CONFIG.ARM_LENGTH)
	lamp.Material   = Enum.Material.SmoothPlastic
	lamp.Color      = Color3.fromRGB(220, 220, 200)
	lamp.Parent     = model
	model.PrimaryPart = lamp

	-- Downward surface glow (pool of light on road)
	local surf = Instance.new("SurfaceLight", lamp)
	surf.Name       = "SurfaceGlow"
	surf.Face       = Enum.NormalId.Bottom
	surf.Color      = CONFIG.LIGHT_COLOR
	surf.Brightness = CONFIG.LIGHT_BRIGHTNESS
	surf.Range      = CONFIG.LIGHT_RANGE
	surf.Angle      = 80
	surf.Shadows    = true

	-- Wide-radius point light
	local pt = Instance.new("PointLight", lamp)
	pt.Name       = "Glow"
	pt.Color      = CONFIG.LIGHT_COLOR
	pt.Brightness = CONFIG.LIGHT_BRIGHTNESS
	pt.Range      = CONFIG.LIGHT_RANGE
	pt.Shadows    = true

	model.Parent = parent
	return { model = model, pointLight = pt, surfaceLight = surf, lamp = lamp }
end

-- ============================================================
-- SPAWN ALL STREETLIGHTS
-- ============================================================

local function spawnStreetlights()
	local container = workspace:FindFirstChild(CONFIG.LIGHTS_FOLDER_NAME)
	if container then container:Destroy() end
	container = Instance.new("Folder")
	container.Name   = CONFIG.LIGHTS_FOLDER_NAME
	container.Parent = workspace

	local roads = collectRoadParts()

	if #roads == 0 then
		warn("[StreetLights] No road parts detected.\n" ..
			"Fix options (pick ONE):\n" ..
			"  1. Rename road parts so the name contains 'Road', 'Street', etc.\n" ..
			"  2. Tag road parts with the Tag Editor using the tag '" .. CONFIG.ROAD_TAG .. "'.\n" ..
			"  3. Set DEBUG_MODE = true in the CONFIG to list all workspace parts\n" ..
			"     so you can see exactly what they are named."
		)
		return {}
	end

	local allLights = {}
	for _, road in ipairs(roads) do
		for _, entry in ipairs(polePositionsForRoad(road)) do
			local light = buildStreetlight(container, entry.pos, entry.forward)
			table.insert(allLights, light)
		end
	end

	print(string.format("[StreetLights] Placed %d streetlights.", #allLights))
	return allLights
end

-- ============================================================
-- DAY / NIGHT CYCLE
-- ============================================================

local function lightsOnNow()
	if CONFIG.ALWAYS_ON then return true end
	local t = Lighting.ClockTime
	if CONFIG.LIGHTS_ON_TIME > CONFIG.LIGHTS_OFF_TIME then
		return t >= CONFIG.LIGHTS_ON_TIME or t < CONFIG.LIGHTS_OFF_TIME
	else
		return t >= CONFIG.LIGHTS_ON_TIME and t < CONFIG.LIGHTS_OFF_TIME
	end
end

local function setLightState(entry, on)
	local brightness = on and CONFIG.LIGHT_BRIGHTNESS or 0
	local info = TweenInfo.new(CONFIG.FADE_TIME, Enum.EasingStyle.Quad)
	TweenService:Create(entry.pointLight,  info, { Brightness = brightness }):Play()
	TweenService:Create(entry.surfaceLight, info, { Brightness = brightness }):Play()
	local col = on and CONFIG.LIGHT_COLOR or Color3.fromRGB(150, 150, 140)
	TweenService:Create(entry.lamp, info, { Color = col }):Play()
end

local function applyToAll(lights, on)
	for _, e in ipairs(lights) do setLightState(e, on) end
end

-- ============================================================
-- MAIN
-- ============================================================

task.spawn(function()
	task.wait(3)   -- let the map finish loading

	local allLights = spawnStreetlights()
	if #allLights == 0 then return end

	local currentlyOn = lightsOnNow()
	applyToAll(allLights, currentlyOn)

	while task.wait(5) do
		local shouldBeOn = lightsOnNow()
		if shouldBeOn ~= currentlyOn then
			currentlyOn = shouldBeOn
			applyToAll(allLights, currentlyOn)
			print(string.format("[StreetLights] Lights %s (ClockTime=%.1f)",
				currentlyOn and "ON" or "OFF", Lighting.ClockTime))
		end
	end
end)
