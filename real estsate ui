-- RealEstateClient (LocalScript inside StarterGui > RealEstateGui)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Events             = ReplicatedStorage:WaitForChild("Events")
local openRealEstateEvent = Events:WaitForChild("OpenRealEstate")
local lotDataUpdatedEvent = Events:WaitForChild("LotDataUpdated")
local updateCurrencyEvent = Events:WaitForChild("UpdateCurrency")
local purchaseCasinoEvent = Events:WaitForChild("PurchaseCasino")
local sellCasinoEvent     = Events:WaitForChild("SellCasino")

local currentLotData = {}
local currentCurrency = 0

-- ── Get ScreenGui ─────────────────────────────────────────────────────────────
local screenGui = playerGui:WaitForChild("RealEstateGui")

-- ── Build GUI (fully programmatic) ───────────────────────────────────────────
local frame = Instance.new("Frame")
frame.Name = "Frame"
frame.Size = UDim2.new(0, 520, 0, 560)
frame.Position = UDim2.new(0.5, -260, 0.5, -280)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
frame.BorderSizePixel = 0
frame.Visible = false
frame.ZIndex = 10
frame.Parent = screenGui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

-- Title bar
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 55)
titleBar.BackgroundColor3 = Color3.fromRGB(30, 30, 48)
titleBar.BorderSizePixel = 0
titleBar.ZIndex = 11
titleBar.Parent = frame
Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 12)

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -60, 1, 0)
titleLabel.Position = UDim2.new(0, 16, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "🏢  Real Estate Agency"
titleLabel.TextColor3 = Color3.fromRGB(255, 210, 50)
titleLabel.TextSize = 20
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.ZIndex = 12
titleLabel.Parent = titleBar

-- Close button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 36, 0, 36)
closeBtn.Position = UDim2.new(1, -46, 0.5, -18)
closeBtn.BackgroundColor3 = Color3.fromRGB(190, 40, 40)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.TextSize = 18
closeBtn.Font = Enum.Font.GothamBold
closeBtn.BorderSizePixel = 0
closeBtn.ZIndex = 13
closeBtn.Parent = titleBar
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

-- Cash display
local cashLabel = Instance.new("TextLabel")
cashLabel.Name = "CashLabel"
cashLabel.Size = UDim2.new(1, -20, 0, 28)
cashLabel.Position = UDim2.new(0, 10, 0, 58)
cashLabel.BackgroundTransparency = 1
cashLabel.Text = "💵  Your Cash: $0"
cashLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
cashLabel.TextSize = 14
cashLabel.Font = Enum.Font.Gotham
cashLabel.TextXAlignment = Enum.TextXAlignment.Left
cashLabel.ZIndex = 11
cashLabel.Parent = frame

-- Scroll frame for lot cards
local scroll = Instance.new("ScrollingFrame")
scroll.Name = "LotList"
scroll.Size = UDim2.new(1, -16, 1, -100)
scroll.Position = UDim2.new(0, 8, 0, 92)
scroll.BackgroundColor3 = Color3.fromRGB(12, 12, 22)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 5
scroll.ScrollBarImageColor3 = Color3.fromRGB(255, 210, 50)
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.ZIndex = 11
scroll.Parent = frame
Instance.new("UICorner", scroll).CornerRadius = UDim.new(0, 8)

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = scroll

local padding = Instance.new("UIPadding")
padding.PaddingTop    = UDim.new(0, 8)
padding.PaddingBottom = UDim.new(0, 8)
padding.PaddingLeft   = UDim.new(0, 8)
padding.PaddingRight  = UDim.new(0, 8)
padding.Parent = scroll

-- ── Constants ─────────────────────────────────────────────────────────────────
local PRICES = { Blue = 2500, Yellow = 10000, Pink = 100000 }
local COLORS = {
	Blue   = Color3.fromRGB(80, 160, 255),
	Yellow = Color3.fromRGB(255, 210, 50),
	Pink   = Color3.fromRGB(255, 130, 180),
}

local function fmt(n)
	if n >= 1e6 then return ("$%.1fM"):format(n/1e6)
	elseif n >= 1e3 then return ("$%.1fK"):format(n/1e3)
	else return "$"..n end
end

-- ── Build Lot Cards ───────────────────────────────────────────────────────────
local function buildCards()
	for _, v in ipairs(scroll:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end

	for i, lot in ipairs(currentLotData) do
		local lType    = lot.lotType or "Blue"
		local price    = PRICES[lType] or 2500
		local sellAmt  = math.floor(price * 0.4)
		local uid      = tostring(player.UserId)
		local isOwned  = lot.ownerId == uid
		local isTaken  = lot.ownerId ~= nil and not isOwned
		local isBroke  = not isOwned and not isTaken and currentCurrency < price

		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, 0, 0, 76)
		card.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
		card.BorderSizePixel = 0
		card.LayoutOrder = i
		card.ZIndex = 12
		card.Parent = scroll
		Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

		-- Color accent strip
		local strip = Instance.new("Frame")
		strip.Size = UDim2.new(0, 5, 1, -16)
		strip.Position = UDim2.new(0, 0, 0, 8)
		strip.BackgroundColor3 = COLORS[lType] or Color3.new(1,1,1)
		strip.BorderSizePixel = 0
		strip.ZIndex = 13
		strip.Parent = card
		Instance.new("UICorner", strip).CornerRadius = UDim.new(0, 4)

		-- Lot name
		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(0.6, 0, 0, 28)
		name.Position = UDim2.new(0, 14, 0, 10)
		name.BackgroundTransparency = 1
		name.Text = lType .. " Casino  •  Lot " .. tostring(lot.lotId or i)
		name.TextColor3 = Color3.fromRGB(240, 240, 240)
		name.TextSize = 14
		name.Font = Enum.Font.GothamBold
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.ZIndex = 13
		name.Parent = card

		-- Sub-label (price/sell info)
		local sub = Instance.new("TextLabel")
		sub.Size = UDim2.new(0.6, 0, 0, 22)
		sub.Position = UDim2.new(0, 14, 0, 40)
		sub.BackgroundTransparency = 1
		sub.TextSize = 12
		sub.Font = Enum.Font.Gotham
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.ZIndex = 13
		sub.Parent = card

		-- Action button
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 110, 0, 38)
		btn.Position = UDim2.new(1, -120, 0.5, -19)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 14
		btn.BorderSizePixel = 0
		btn.ZIndex = 13
		btn.Parent = card
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

		if isOwned then
			sub.Text = "Sell for " .. fmt(sellAmt)
			sub.TextColor3 = Color3.fromRGB(255, 100, 100)
			btn.Text = "SELL"
			btn.BackgroundColor3 = Color3.fromRGB(190, 40, 40)
			btn.TextColor3 = Color3.fromRGB(255,255,255)
			btn.MouseButton1Click:Connect(function()
				sellCasinoEvent:FireServer(lot.lotId)
			end)
		elseif isTaken then
			sub.Text = "Owned by another player"
			sub.TextColor3 = Color3.fromRGB(120, 120, 120)
			btn.Text = "TAKEN"
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
			btn.TextColor3 = Color3.fromRGB(100,100,100)
			btn.Active = false
		elseif isBroke then
			sub.Text = "Need " .. fmt(price - currentCurrency) .. " more"
			sub.TextColor3 = Color3.fromRGB(200, 80, 80)
			btn.Text = "BROKE"
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
			btn.TextColor3 = Color3.fromRGB(100,100,100)
			btn.Active = false
		else
			sub.Text = "Buy for " .. fmt(price)
			sub.TextColor3 = Color3.fromRGB(100, 220, 100)
			btn.Text = "BUY"
			btn.BackgroundColor3 = Color3.fromRGB(35, 160, 75)
			btn.TextColor3 = Color3.fromRGB(255,255,255)
			btn.MouseButton1Click:Connect(function()
				purchaseCasinoEvent:FireServer(lot.lotId)
			end)
		end
	end

	-- Resize scroll canvas
	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
end

-- ── Wire Events ───────────────────────────────────────────────────────────────
closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

openRealEstateEvent.OnClientEvent:Connect(function()
	buildCards()
	frame.Visible = true
end)

lotDataUpdatedEvent.OnClientEvent:Connect(function(data)
	currentLotData = data or {}
	if frame.Visible then buildCards() end
end)

updateCurrencyEvent.OnClientEvent:Connect(function(amount)
	currentCurrency = amount or 0
	cashLabel.Text = "💵  Your Cash: " .. fmt(amount)
	if frame.Visible then buildCards() end
end)
