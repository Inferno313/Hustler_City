-- ── Helpers ───────────────────────────────────────────────────────────────────
local function posOnRing(deg)
	local rad=math.rad(deg)
	return UDim2.new(0, DIAL_SIZE/2+math.sin(rad)*RADIUS, 0, DIAL_SIZE/2-math.cos(rad)*RADIUS)
end

local function placeZone(deg)
	zone.Position=posOnRing(deg); zone.Rotation=deg
end

local function angleDiff(a,b)
	local d=(a-b)%360; if d>180 then d=d-360 end; return math.abs(d)
end

local function inZone()
	return angleDiff(currentAngle,targetAngle)<=TARGET_DEG
end

local function speedColor(s)
	if s<200 then     return Color3.fromRGB(160,60,255)   -- purple
	elseif s<350 then return Color3.fromRGB(255,200,0)    -- gold
	elseif s<500 then return Color3.fromRGB(255,130,0)    -- orange
	elseif s<800 then return Color3.fromRGB(255,40,40)    -- red
	else              return Color3.fromRGB(0,220,255)    -- electric blue (max tier)
	end
end

local function setBanner(text,bg,fg)
	pressLbl.Text=text; banner.BackgroundColor3=bg; pressLbl.TextColor3=fg; banner.Visible=true
end

-- ── Core ──────────────────────────────────────────────────────────────────────
local function closeUI()
	sg.Enabled=false
	if animConn then animConn:Disconnect(); animConn=nil end
	isPlaying=false; hitCooldown=false
end

local function endMinigame(voluntary)
	if not isPlaying then return end
	closeUI()
	if voluntary then
		stopEvent:FireServer()
		if totalEarned > 0 then
			payoutSound.TimePosition = 0
			payoutSound:Play()
		end
	else
		resultEvent:FireServer(false)
		-- play miss sound on non-voluntary end
		missSound.TimePosition = 0
		missSound:Play()
	end
	totalEarned=0
	earnLbl.Text="PENDING: $0  (paid on stop)"
	stopBtn.Text="✅  STOP & COLLECT $0"
end

local function startMinigame(rawSpeed)
	local speed=tonumber(rawSpeed) or 150
	rotSpeed=speed
	ringStroke.Color=speedColor(speed)
	speedLbl.Text=string.format("SPEED: %.0f°/s", speed)
	rewardLbl.Text=string.format("NEXT HIT: $%d", calcReward(speed))
	if isPlaying then return end

	isPlaying=true; hitCooldown=false
	currentAngle=0; targetAngle=math.random(0,359)
	totalEarned=0
	earnLbl.Text="PENDING: $0  (paid on stop)"
	stopBtn.Text="✅  STOP & COLLECT $0"

	placeZone(targetAngle)
	zone.BackgroundColor3=Color3.fromRGB(60,220,90)
	setBanner("▶  PRESS  SPACEBAR",Color3.fromRGB(255,200,0),Color3.fromRGB(20,10,40))
	stopBtn.Visible=false
	sg.Enabled=true

	animConn=RunService.RenderStepped:Connect(function(dt)
		if not isPlaying then return end
		currentAngle=(currentAngle+rotSpeed*dt)%360
		local p=posOnRing(currentAngle)
		dot.Position=p; glow.Position=p
		zone.BackgroundColor3=inZone()
			and Color3.fromRGB(130,255,150)
			or  Color3.fromRGB(60,220,90)
	end)
end

-- ── Input ─────────────────────────────────────────────────────────────────────
UIS.InputBegan:Connect(function(input,processed)
	if processed or not isPlaying or hitCooldown then return end
	if input.KeyCode~=Enum.KeyCode.Space then return end

	if inZone() then
		hitCooldown=true
		local reward=calcReward(rotSpeed)
		totalEarned+=reward
		-- dynamic pitch scaling + instant-rewind
		hitSound.PlaybackSpeed = math.clamp(rotSpeed / 300, 0.9, 1.5)
		hitSound.TimePosition = 0
		hitSound:Play()
		earnLbl.Text=string.format("PENDING: $%d  (paid on stop)", totalEarned)
		stopBtn.Text=string.format("✅  STOP & COLLECT $%d", totalEarned)
		setBanner(string.format("✅  HIT! +$%d", reward),Color3.fromRGB(50,210,90),Color3.fromRGB(255,255,255))
		stopBtn.Visible=false

		targetAngle=math.random(0,359)
		placeZone(targetAngle)
		resultEvent:FireServer(true)

		task.delay(0.7,function()
			if isPlaying then
				setBanner("▶  PRESS  SPACEBAR",Color3.fromRGB(255,200,0),Color3.fromRGB(20,10,40))
				stopBtn.Visible=true
				rewardLbl.Text=string.format("NEXT HIT: $%d", calcReward(rotSpeed))
			end
			hitCooldown=false
		end)
	else
		setBanner(string.format("❌  MISS!  Lost $%d", totalEarned),Color3.fromRGB(200,40,40),Color3.fromRGB(255,255,255))
		endMinigame(false)
	end
end)

stopBtn.MouseButton1Click:Connect(function() endMinigame(true) end)
openEvent.OnClientEvent:Connect(function(speed) startMinigame(speed) end)
