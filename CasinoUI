local function showResult(lbl, text, win)
	lbl.Text = text
	lbl.TextColor3 = win
		and Color3.fromRGB(60, 220, 100)
		or  Color3.fromRGB(255, 80, 80)
	TweenService:Create(lbl, TweenInfo.new(0.3, Enum.EasingStyle.Back), {TextSize = 20}):Play()
	task.delay(0.3, function()
		TweenService:Create(lbl, TweenInfo.new(0.2), {TextSize = 18}):Play()
	end)
end

