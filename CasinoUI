-- ============================================================
-- HELPERS
-- ============================================================
local function corner(p, r) Instance.new("UICorner", p).CornerRadius = UDim.new(0, r or 12) end
local function stroke(p, c, t)
	local s = Instance.new("UIStroke", p); s.Color = c; s.Thickness = t or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end
local function formatCash(n)
	if n >= 1000000 then return string.format("$%.2fM", n/1000000)
	elseif n >= 1000 then return string.format("$%.1fK", n/1000)
	else return "$"..math.floor(n) end
end

