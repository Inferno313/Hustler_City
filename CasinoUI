local function formatCards(hand)
	if not hand then return "—", "" end
	local str = ""
	for _, card in ipairs(hand) do
		str = str .. card.Face .. card.Suit .. " "
	end
	return str, ""
end

local function bjAction(action, betStr)
	local bet = tonumber(betStr) or 100
	local ok, result = pcall(function()
		return PlayBlackjack:InvokeServer(action, bet)
	end)
	if not ok or not result then return end

	if result.PlayerHand then
		playerCardsLbl.Text = formatCards(result.PlayerHand)
		if result.PlayerValue then playerValueLbl.Text = tostring(result.PlayerValue) end
	end
	if result.DealerHand then
		dealerCardsLbl.Text = formatCards(result.DealerHand)
		if result.DealerValue then dealerValueLbl.Text = tostring(result.DealerValue) end
	elseif result.DealerHiddenCard then
		dealerCardsLbl.Text = result.DealerHiddenCard.Face .. result.DealerHiddenCard.Suit .. " 🂠"
		dealerValueLbl.Text = "?"
	end

	if result.GameOver then
		showResult(bjResult, result.Result, result.Payout and result.Payout > 0)
		if result.NewCash then
			bjBal.Text = "Balance: " .. formatCash(result.NewCash)
			balanceLabel.Text = "💰 Balance: " .. formatCash(result.NewCash)
		end
		bjHitBtn.Visible = false; bjStandBtn.Visible = false; bjDoubleBtn.Visible = false
		bjNewBtn.Visible = true;  bjDealBtn.Visible = false
	elseif action == "deal" then
		bjDealBtn.Visible = false
