local function makeBetRow(parent, yPos, minBet)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, -40, 0, 44)
	frame.Position = UDim2.new(0, 20, 0, yPos)
	frame.BackgroundColor3 = Color3.fromRGB(14, 7, 28)
	frame.BorderSizePixel = 0
	frame.ZIndex = parent.ZIndex + 1
	corner(frame, 10)
	stroke(frame, Color3.fromRGB(80, 40, 120), 1)

	local betLbl = Instance.new("TextLabel", frame)
	betLbl.Size = UDim2.new(0, 50, 1, 0)
	betLbl.BackgroundTransparency = 1
	betLbl.Text = "BET:"
	betLbl.Font = Enum.Font.GothamBold
	betLbl.TextSize = 13
	betLbl.TextColor3 = Color3.fromRGB(180, 150, 220)
	betLbl.ZIndex = frame.ZIndex + 1

	local betBox = Instance.new("TextBox", frame)
	betBox.Name = "BetBox"
	betBox.Size = UDim2.new(1, -120, 0.8, 0)
	betBox.Position = UDim2.new(0, 54, 0.1, 0)
	betBox.BackgroundColor3 = Color3.fromRGB(20, 10, 36)
	betBox.BorderSizePixel = 0
	betBox.Text = tostring(minBet)
	betBox.Font = Enum.Font.GothamBold
	betBox.TextSize = 16
	betBox.TextColor3 = Color3.fromRGB(255, 215, 50)
	betBox.PlaceholderText = "Enter bet"
	betBox.ZIndex = frame.ZIndex + 1
	corner(betBox, 8)

	-- Quick bet buttons
	local quickBets = {minBet, minBet*5, minBet*20}
	for i, amt in ipairs(quickBets) do
		local qBtn = Instance.new("TextButton", frame)
		qBtn.Size = UDim2.new(0, 28, 0.7, 0)
		qBtn.Position = UDim2.new(1, -36 + (i-3)*32, 0.15, 0)
		qBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 90)
		qBtn.BorderSizePixel = 0
		qBtn.Text = i == 3 and "MAX" or (amt >= 1000 and math.floor(amt/1000).."K" or tostring(amt))
		qBtn.Font = Enum.Font.GothamBold
		qBtn.TextSize = 9
		qBtn.TextColor3 = Color3.fromRGB(200, 160, 255)
		qBtn.ZIndex = frame.ZIndex + 2
		corner(qBtn, 6)
		local betAmount = amt
		qBtn.MouseButton1Click:Connect(function()
			betBox.Text = tostring(betAmount)
		end)
	end

	return frame, betBox
end

