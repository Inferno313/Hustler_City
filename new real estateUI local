local function fmt(n)
	if n >= 1e6 then return "$" .. string.format("%.1fM", n/1e6) end
	if n >= 1e3 then return "$" .. string.format("%.1fK", n/1e3) end
	return "$" .. tostring(n)
end

local function corner(parent, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 10); c.Parent = parent
end
local function padding(parent, px)
	local p = Instance.new("UIPadding")
	p.PaddingTop    = UDim.new(0, px); p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft   = UDim.new(0, px); p.PaddingRight  = UDim.new(0, px)
	p.Parent = parent
end
local function label(parent, text, size, color, bold, xa)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1; l.TextScaled = true
	l.Text = text; l.TextColor3 = color or TEXT
	l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	l.TextXAlignment = xa or Enum.TextXAlignment.Left
	l.Size = size; l.Parent = parent
	return l
end

